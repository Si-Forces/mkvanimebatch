// Redesign C's episode list (desktop-tauri/ui/index.html .main, queue-view.js, style.css). Layout
// and bindings only: the host maps every row and the header (desktop-slint/src/queue.rs) and does
// what the controls ask.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Focus, Pressable, TipCard } from "focus.slint";

export enum Mode { remux, extract }

export enum QueueFilter { all, todo, done, failed }

export enum RowTone { info, ok, err, mute }

// The status mark beside the label.
export enum RowMark { none, ring, spin, ok, err }

export struct QueueRow {
    id: string,
    num: string,
    name: string,
    meta: string,
    meta-error: bool,
    label: string,
    tone: RowTone,
    mark: RowMark,
    // Percent, for the ring's arc.
    progress: float,
    // The status hover text.
    title: string,
    selected: bool,
    check-label: string,
    // Whether the filter shows the row; a hidden row stays in the model with no height.
    shown: bool,
    // The header of the row's release, and how many rows of its run the filter shows, when the
    // queue spans more than one release; `opens`: the row starts the run, with the header above.
    head: string,
    head-count: int,
    opens: bool,
}

export struct QueueHead {
    title: string,
    crumbs-lead: string,
    crumbs-end: string,
    all: int,
    todo: int,
    done: int,
    failed: int,
    filter: QueueFilter,
    filter-empty: bool,
    // The card shown instead of the rows: its texts, its button (none when empty) and a spinner.
    card-shown: bool,
    card-title: string,
    card-text: string,
    card-action: string,
    card-spinner: bool,
    selection-locked: bool,
    // The row the Episode Inspector shows.
    inspected: string,
}

// The spinning rings' turn, one for all of them: still under Reduce motion, as style.css's
// prefers-reduced-motion stops .ep-ring and .scan-spinner. Read only while a ring spins, so the
// window draws no frame for it otherwise.
export global Spin {
    out property <angle> turn: Theme.reduce-motion ? 0deg : mod(animation-tick(), 1100ms) / 1100ms * 360deg;
}

// The status ring (.ep-ring): a track and the progress arc, or a spinning quarter.
component Ring inherits Rectangle {
    in property <float> progress;
    in property <bool> spinning;
    property <angle> end: spinning ? 90deg : clamp(progress, 0.5, 99.9) / 100 * 360deg;
    width: 20px;
    height: 20px;

    Path {
        width: 20px;
        height: 20px;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: Theme.line;
        stroke-width: 3px;
        commands: "M 10 2 A 8 8 0 1 1 9.99 2";
    }
    Path {
        width: 20px;
        height: 20px;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: Theme.info;
        stroke-width: 3px;
        stroke-line-cap: round;
        transform-rotation: root.spinning ? Spin.turn : 0deg;
        MoveTo { x: 10; y: 2; }
        ArcTo {
            x: 10 + 8 * Math.sin(root.end);
            y: 10 - 8 * Math.cos(root.end);
            radius-x: 8;
            radius-y: 8;
            large-arc: root.end > 180deg;
            sweep: true;
        }
    }
}

component Glyph inherits Path {
    in property <string> glyph;
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 2.5px;
    stroke-line-cap: round;
    commands: glyph;
}

component ReorderButton inherits Pressable {
    in property <string> glyph;
    width: 22px;
    height: 18px;
    border-radius: 5px;
    background: self.hovered && self.enabled ? Theme.sel : transparent;
    // Dimmed while locked, as the other buttons are.
    opacity: self.enabled ? 1 : 0.5;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.hovered && root.enabled ? Theme.fg : Theme.mute;
        stroke-width: 3px;
        stroke-line-cap: round;
        commands: root.glyph;
        accessible-role: none;
    }
}

// A release's header (.ep-group-head): its name and how many rows of its run the filter shows.
component GroupHead inherits Rectangle {
    in property <string> text;
    in property <int> count;
    // The copy pinned at the list's top: a click on it reaches no row. Only the row's own header
    // is read out (its instance's label).
    in property <bool> pinned;
    height: 30px;
    // Square at the top, as style.css's `border-radius: 0 0 10px 10px`.
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    if root.pinned: TouchArea { }
    background: Theme.head;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: Theme.mute;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.66px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.count;
            color: Theme.mute;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The release header pinned at the list's top: its text and count, none when `text` is empty;
// `y`, the place of the row that pins it, so a row laid out anew reports it again (without it
// a scroll that brings back the same text, count and row index pins nothing: tested); `row`, its
// index in the rows, so a header whose row was replaced (another folder) is no longer shown.
struct PinnedHead {
    text: string,
    count: int,
    y: length,
    row: int,
}

// One row (.ep-row) with the release header above it when it starts a run.
component EpRow inherits Rectangle {
    in property <QueueRow> item;
    in property <bool> inspected;
    in property <bool> locked;
    // A filter shows: the order cannot change.
    in property <bool> filtered;
    // Names the row's controls for `Focus.restore`: the mode and the row's id.
    in property <string> key;
    // The row's index in the list's rows.
    in property <int> index;
    // The list's scroll offset (negative going down), against which the row finds the list's top.
    in property <length> scroll;
    callback toggle();
    callback pick();
    callback move-up();
    callback move-down();

    // The row spans the list's top edge: its run's header pins there (`position: sticky`), unless
    // the row's own header shows whole at the top. One comparison per row laid out, on a scroll.
    out property <PinnedHead> pinned: item.shown && item.head != ""
        && self.y + root.scroll <= 0 && self.y + self.height + root.scroll > 0
        && !(item.opens && self.y + root.scroll >= 0)
        ? { text: item.head, count: item.head-count, y: self.y, row: root.index } : { text: "", count: 0, y: 0, row: -1 };

    property <length> head-height: item.opens ? 30px : 0px;
    property <color> tone-color: item.tone == RowTone.info ? Theme.info
        : item.tone == RowTone.ok ? Theme.ok
        : item.tone == RowTone.err ? Theme.err
        : Theme.mute;
    // Not `visible`: on a ListView row's root it wraps the row, and the ListView then cannot
    // place it. A hidden row has no height and draws nothing; a filter that hides every row makes
    // the ListView make and lay out all of them, looking for one to fill its height with.
    height: item.shown ? self.head-height + 52px : 0px;

    if item.shown && item.opens: GroupHead {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        accessible-role: text;
        accessible-label: root.item.head + " " + root.item.head-count;
        text: root.item.head;
        count: root.item.head-count;
    }

    // The list's side padding (.list: 0 12px).
    if item.shown: body := TouchArea {
        x: 12px;
        y: root.head-height;
        width: parent.width - 24px;
        height: 52px;
        // A control of the row has the focus: Move up / Move down show (.ep-row:focus-within).
        property <bool> focus-within: check.focused || pick.focused || up.focused || down.focused;

        Rectangle {
            border-radius: 10px;
            background: root.inspected ? Theme.accent-soft : body.has-hover ? Theme.hover : transparent;
            border-width: root.inspected ? 1px : 0px;
            border-color: Theme.accent-ring;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 10px;

            // The checkbox (.ep-select-check).
            VerticalLayout {
                alignment: center;
                check := Pressable {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: root.item.selected ? Theme.accent : Theme.field;
                    border-width: root.item.selected ? 0px : 1.5px;
                    border-color: Theme.mute;
                    opacity: root.locked ? 0.5 : 1;
                    enabled: !root.locked;
                    cursor: default;
                    focus-key: "check:" + root.key;
                    accessible-role: checkbox;
                    accessible-checkable: true;
                    accessible-checked: root.item.selected;
                    accessible-label: root.item.check-label;
                    clicked => { root.toggle(); }

                    if root.item.selected: Path {
                        width: 10px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M 1.5 5.2 L 4 7.7 L 8.5 2.5";
                        stroke: Theme.accent-fg;
                        stroke-width: 1.8px;
                        accessible-role: none;
                    }
                }
            }

            // The pick (.ep-pick): number, name and meta line; it inspects the row. Read as the
            // name, then the meta line (the button's content in the webview).
            pick := Pressable {
                horizontal-stretch: 1;
                border-radius: 8px;
                focus-key: "pick:" + root.key;
                accessible-label: root.item.name;
                accessible-description: root.item.meta;
                clicked => { root.pick(); }
                HorizontalLayout {
                    spacing: 12px;
                    opacity: root.item.selected ? 1 : 0.45;
                    Text {
                        width: 44px;
                        text: root.item.num;
                        color: Theme.fg;
                        font-family: "Unbounded";
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.item.name;
                            color: Theme.fg;
                            font-weight: 600;
                            overflow: elide;
                            accessible-role: none;
                        }
                        Text {
                            text: root.item.meta;
                            color: root.item.meta-error ? Theme.err : Theme.path;
                            font-size: 12px;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                }
            }

            // The status (.ep-status): the mark, then the label in the row's tone; its `title`
            // the hover tooltip.
            Rectangle {
                max-width: 150px;
                accessible-role: text;
                accessible-label: root.item.label;
                accessible-description: root.item.title;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.item.mark == RowMark.ring || root.item.mark == RowMark.spin: VerticalLayout {
                        alignment: center;
                        Ring {
                            progress: root.item.progress;
                            spinning: root.item.mark == RowMark.spin;
                        }
                    }
                    if root.item.mark == RowMark.ok || root.item.mark == RowMark.err: VerticalLayout {
                        alignment: center;
                        Glyph {
                            stroke: root.tone-color;
                            glyph: root.item.mark == RowMark.ok ? "M5 12.5l4.5 4.5L19 7.5" : "M6 6l12 12M18 6L6 18";
                        }
                    }
                    Text {
                        text: root.item.label;
                        color: root.tone-color;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                if root.item.title != "": Tooltip {
                    TipCard {
                        text: root.item.title;
                    }
                }
            }

            // Move up / Move down (.ep-reorder): shown on hover or with a row control focused;
            // while a filter shows, gone from the accessibility tree too, their width kept
            // (style.css's `visibility: hidden`).
            Rectangle {
                width: 22px;
                visible: !root.filtered;
                opacity: body.has-hover || body.focus-within ? 1 : 0;
                VerticalLayout {
                    alignment: center;
                    up := ReorderButton {
                        glyph: "M6 15l6-6 6 6";
                        enabled: !root.locked;
                        focus-key: "up:" + root.key;
                        accessible-label: "Move up";
                        clicked => { root.move-up(); }
                    }
                    down := ReorderButton {
                        glyph: "M6 9l6 6 6-6";
                        enabled: !root.locked;
                        focus-key: "down:" + root.key;
                        accessible-label: "Move down";
                        clicked => { root.move-down(); }
                    }
                }
            }
        }
    }
}

// A filter chip (.chip): its label and how many rows it shows.
component Chip inherits Pressable {
    in property <string> label;
    in property <int> count;
    in property <bool> on;
    height: 24px;
    width: content.preferred-width + 24px;
    border-radius: self.height / 2;
    background: on ? Theme.fg : Theme.sel;
    border-width: 1px;
    border-color: on ? Theme.fg : self.hovered ? Theme.mute : Theme.line;
    accessible-label: label + " " + count;
    accessible-checkable: true;
    accessible-checked: on;

    content := HorizontalLayout {
        x: 12px;
        width: self.preferred-width;
        spacing: 4px;
        Text {
            text: root.label;
            color: root.on ? Theme.bg : Theme.mute;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            accessible-role: none;
        }
        Text {
            text: root.count;
            color: root.on ? Theme.bg : Theme.mute;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A text button (.link-btn).
export component LinkButton inherits Pressable {
    in property <string> text;
    width: label.preferred-width + 8px;
    height: 24px;
    border-radius: 6px;
    accessible-label: text;
    label := Text {
        text: root.text;
        color: Theme.accent;
        opacity: root.enabled ? 1 : 0.5;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The accent button (.btn.btn-accent).
component AccentButton inherits Pressable {
    in property <string> text;
    width: label.preferred-width + 36px;
    height: 36px;
    border-radius: self.height / 2;
    background: Theme.accent;
    opacity: self.enabled ? 1 : 0.5;
    accessible-label: text;
    label := Text {
        text: root.text;
        color: Theme.accent-fg;
        font-weight: 700;
        accessible-role: none;
    }
}

// One mode's list pane (.main): the list header, the filters, then the rows or a card.
export component QueuePane inherits Rectangle {
    in property <QueueHead> head;
    in property <[QueueRow]> rows;
    // A start or a job holds the batch: the selection hint says so (html.job-locked).
    in property <bool> busy;
    // That, or a Run not answered yet: the card's Open folder is locked.
    in property <bool> locked;
    // A row picked for the Episode Inspector whose Inspect is not answered yet: marked at once.
    in property <string> pending-inspect;
    callback set-selected(id: string, selected: bool);
    callback set-all-selected(selected: bool);
    callback reorder(id: string, up: bool);
    callback inspect(id: string);
    callback set-filter(filter: QueueFilter);
    callback open-folder();
    // The list's scroll offset (negative going down), kept by the window per mode.
    in-out property <length> list-scroll;
    // The mode, which names the pane's controls for `Focus.restore` apart from the other pane's.
    in property <string> name;

    // Scrolls the list so row `row` heads it (queue-view.js `revealRelease`; row 0 for the top, as
    // the folder's Library entry and a card put it), or as near as the end of the list lets it.
    // `ensure-row-visible` puts a row above the viewport at its top edge, measuring the rows it
    // lays out, where a scroll offset (even 0, after the rows were replaced) is placed by the
    // ListView's estimated row height: so the list first moves past every row. It measures only
    // once the list laid out a row with a height: after a filter that hid every row, its content
    // has none (`content-height` 0) and the row would land at the bottom, so the reveal waits for
    // the layout that shows the rows again (`changed content-height` below), in that same frame.
    public function reveal(row: int) {
        root.unpin();
        root.reveal-pending = -1;
        if row < 0 || row >= root.rows.length {
            root.list-scroll = 0;
            return;
        }
        if list.content-height <= 0 {
            root.reveal-pending = row;
            return;
        }
        // Past the end of every row: no row is taller than a release head over a row.
        root.list-scroll = -root.rows.length * root.tallest-row;
        list.ensure-row-visible(row, ScrollBehavior.instant);
    }

    // A filter chip clicked: the filter wins over a reveal still waiting for its layout.
    function filter(filter: QueueFilter) {
        root.reveal-pending = -1;
        root.set-filter(filter);
    }

    // The row a reveal waits to scroll to, or -1.
    property <int> reveal-pending: -1;
    // EpRow at its tallest: a release head over the row.
    property <length> tallest-row: 30px + 52px;
    // The row marked as inspected: the one picked, until its Inspect is answered.
    out property <string> marked: pending-inspect != "" ? pending-inspect : head.inspected;

    // The release header pinned at the list's top, and the row instance that pinned it: rows
    // report it as they cross the top (in no set order), and only the one that pinned it unpins
    // it. A ListView keeps its row instances as it scrolls, so each is numbered once, when made.
    // New rows (another folder) make new instances, and the old one never unpins: the header shows
    // only while the row it names still belongs to that release.
    property <PinnedHead> pinned-head;
    // The pinned header's text (empty for none shown) and count, for the host's tests. An index
    // past the rows (a smaller folder's) reads a default row, whose empty head never matches:
    // `pin` keeps only a non-empty head.
    out property <string> pinned-text: !root.head.card-shown && root.list-scroll < 0
        && root.pinned-head.row >= 0 && root.rows[root.pinned-head.row].head == root.pinned-head.text
        ? root.pinned-head.text : "";
    out property <int> pinned-count: root.pinned-text == "" ? 0 : root.pinned-head.count;
    property <int> pinned-by: -1;
    property <int> rows-made;
    // The first rows made after a reset disarm `Focus.follow-key` (this handler runs once that
    // pass made them): a moved episode's row not made then (scrolled out) or disabled takes no
    // focus when a scroll makes it later.
    changed rows-made => {
        Focus.follow-key = "";
    }
    // The rows were replaced (the instance that pinned the header is gone without unpinning it,
    // and a same-folder reset keeps the heads `pinned-text` checks), or a reveal puts a row at the
    // top: the rows made, or moved across the top, report again.
    public function unpin() {
        root.pinned-head = { text: "", count: 0, y: 0, row: -1 };
        root.pinned-by = -1;
    }
    function pin(instance: int, head: PinnedHead) {
        if head.text != "" {
            root.pinned-head = head;
            root.pinned-by = instance;
        } else if root.pinned-by == instance {
            root.pinned-head = { text: "", count: 0, y: 0, row: -1 };
            root.pinned-by = -1;
        }
    }
    property <bool> filtered: head.filter != QueueFilter.all;
    background: Theme.content;

    VerticalLayout {
        // The list header (.list-head): its own height; the list or the card takes the rest.
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.head.title;
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 700;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            // The whole path on hover, as the crumbs' `title`: they elide.
            if root.head.crumbs-end != "": Rectangle {
                HorizontalLayout {
                    alignment: start;
                    // An overflow shrinks only the stretching lead, down to its ellipsis, before the
                    // leaf: the leaf keeps its width while the lead elides.
                    Text {
                        horizontal-stretch: 1;
                        text: root.head.crumbs-lead;
                        color: Theme.path;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: root.head.crumbs-end;
                        color: Theme.fg;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
                Tooltip {
                    TipCard {
                        text: root.head.crumbs-lead + root.head.crumbs-end;
                    }
                }
            }
            // .list-tools: the chips, then Select all / None at the end, wrapping in a narrow list.
            FlexboxLayout {
                spacing: 6px;
                alignment: stretch;
                cross-axis-alignment: center;
                Chip {
                    label: "All";
                    focus-key: root.name + ":" + self.label;
                    count: root.head.all;
                    on: root.head.filter == QueueFilter.all;
                    clicked => { root.filter(QueueFilter.all); }
                }
                Chip {
                    label: "To do";
                    focus-key: root.name + ":" + self.label;
                    count: root.head.todo;
                    on: root.head.filter == QueueFilter.todo;
                    clicked => { root.filter(QueueFilter.todo); }
                }
                Chip {
                    label: "Done";
                    focus-key: root.name + ":" + self.label;
                    count: root.head.done;
                    on: root.head.filter == QueueFilter.done;
                    clicked => { root.filter(QueueFilter.done); }
                }
                Chip {
                    label: "Failed";
                    focus-key: root.name + ":" + self.label;
                    count: root.head.failed;
                    on: root.head.filter == QueueFilter.failed;
                    clicked => { root.filter(QueueFilter.failed); }
                }
                Rectangle { horizontal-stretch: 1; }
                LinkButton {
                    text: "Select all";
                    focus-key: root.name + ":" + self.text;
                    enabled: !root.head.selection-locked;
                    clicked => { root.set-all-selected(true); }
                }
                LinkButton {
                    text: "None";
                    focus-key: root.name + ":" + self.text;
                    enabled: !root.head.selection-locked;
                    clicked => { root.set-all-selected(false); }
                }
            }
            Text {
                text: root.busy ? "Selection is locked while the batch runs." : "Tick episodes to include them. Click a row to inspect it.";
                color: Theme.mute;
                font-size: 12px;
                // Wraps in a narrow list, as the webview's hint does.
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // The rows, or a card over the hidden list. The list stays made, so the host can scroll
        // it to a row (`reveal`).
        Rectangle {
            vertical-stretch: 1;
            list := ListView {
                width: parent.width;
                height: parent.height;
                visible: !root.head.card-shown;
                content-y <=> root.list-scroll;
                changed content-height => {
                    if root.reveal-pending >= 0 && self.content-height > 0 {
                        root.reveal(root.reveal-pending);
                    }
                }
                for row[index] in root.rows: EpRow {
                    property <int> instance;
                    // A row made already across the top reports it too: `changed` misses a first value.
                    init => {
                        self.instance = root.rows-made;
                        root.rows-made += 1;
                        root.pin(self.instance, self.pinned);
                    }
                    item: row;
                    index: index;
                    inspected: row.id == root.marked;
                    locked: root.head.selection-locked;
                    filtered: root.filtered;
                    key: root.name + ":" + row.id;
                    scroll: root.list-scroll;
                    changed pinned => { root.pin(self.instance, self.pinned); }
                    toggle => { root.set-selected(row.id, !row.selected); }
                    pick => { root.inspect(row.id); }
                    move-up => { root.reorder(row.id, true); }
                    move-down => { root.reorder(row.id, false); }
                }
            }

            // The pinned header (style.css's sticky .ep-group-head), over the rows at the list's
            // top; a click on it reaches no row. Read out once, by the row's own header.
            if root.pinned-text != "": GroupHead {
                x: 12px;
                y: 0;
                width: parent.width - 24px;
                pinned: true;
                // Read out once, by the row's own header.
                accessible-role: none;
                text: root.pinned-head.text;
                count: root.pinned-head.count;
            }

            // .empty-state-card: at most 340px wide, centred; the folder icon, or the spinner
            // while scanning.
            if root.head.card-shown: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 48px;
                alignment: center;
                VerticalLayout {
                    max-width: 340px;
                    spacing: 8px;
                    alignment: start;
                    if root.head.card-spinner: HorizontalLayout {
                        alignment: center;
                        Ring { spinning: true; }
                    }
                    if !root.head.card-spinner: HorizontalLayout {
                        alignment: center;
                        Path {
                            width: 28px;
                            height: 28px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: Theme.mute;
                            // The SVG's 1.8 in its 24-unit viewbox: a Path's stroke is not scaled.
                            stroke-width: 1.8px * 28 / 24;
                            stroke-line-join: round;
                            commands: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: root.head.card-title;
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.head.card-text;
                        color: Theme.mute;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.head.card-action != "": HorizontalLayout {
                        alignment: center;
                        padding-top: 6px;
                        AccentButton {
                            // The mode's, as each pane has one.
                            focus-key: root.name + ":open-folder";
                            text: root.head.card-action;
                            enabled: !root.locked;
                            clicked => { root.open-folder(); }
                        }
                    }
                }
            }
        }

        // After the list, as index.html's .filter-empty (padding 0 32px 20px).
        if root.head.filter-empty: HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-bottom: 20px;
            Text {
                text: "No episodes match this filter.";
                color: Theme.mute;
                wrap: word-wrap;
            }
        }
    }
}

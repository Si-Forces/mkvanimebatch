// Redesign C's tokens, hand-ported from desktop-tauri/ui/style.css (:root and [data-theme="dark"]).
// The host's contrast test reads them back through this global: keep every text and surface token
// here, not inline in a component. Departures from style.css are marked "AA:" (WCAG AA contrast).
import { Palette as StylePalette } from "std-widgets.slint";

export global Theme {
    // Follows the system's colour scheme until `set-dark` pins one: the host calls it at boot for a
    // saved choice, before the first frame, and on the toggle (Ctrl+T), so the two never fight.
    out property <bool> dark: StylePalette.color-scheme == ColorScheme.dark;

    public function set-dark(dark: bool) {
        StylePalette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // The theme toggle or Ctrl+T: the host flips the theme and saves the choice.
    callback toggle();

    // The in-app reduced effects (Q105), for style.css's prefers-reduced-transparency and
    // prefers-reduced-motion: solid panes, no glass; no spinning. The host loads and saves them;
    // `effects-changed` says the sheet's checkboxes changed one.
    in-out property <bool> reduce-transparency;
    in-out property <bool> reduce-motion;
    callback effects-changed();

    // Whether the floating panes (GlassPane) draw the real backdrop blur: the host's, false while
    // its REAL_BLUR is off (appearance.rs), on the software renderer (which cannot blur) and under
    // Reduce transparency. Without it they draw the faked .glass, as style.css does.
    in-out property <bool> glass: false;
    // The blur's strength: Skia's sigma is this length in physical pixels, so 30px is the spike's
    // σ30 (ADR-0017's glass gate) at scale 1, as CSS's blur(30px).
    out property <length> glass-blur: 30px;

    out property <length> window-radius: 14px;
    out property <length> pane-radius: 22px;
    // GlassPane's shadow blur; app.slint draws one at this blur from the first frame (a pre-warm).
    out property <length> pane-shadow-blur: 40px;

    // The wallpaper (--wall): three radial gradients over a base.
    out property <color> wall-a: dark ? #1c3d57 : #bfe3ff;
    out property <color> wall-b: dark ? #3d1f57 : #f3cfff;
    out property <color> wall-c: dark ? #113d34 : #cff7e8;
    out property <color> wall-base: dark ? #0b0e13 : #e8edf4;

    // Surfaces, translucent over the wallpaper.
    out property <color> bg: dark ? #13171b : #f0f3f5;
    // Solid under Reduce transparency, as style.css's prefers-reduced-transparency block.
    out property <color> side: reduce-transparency ? (dark ? #1a1f26 : #e9eef2) : (dark ? #22283275 : #ffffff6b);
    out property <color> panel: reduce-transparency ? (dark ? #1d232a : #f6f8fa) : (dark ? #22283285 : #ffffff85);
    out property <color> content: reduce-transparency ? (dark ? #151a1f : #ffffff) : (dark ? #12161c94 : #ffffffa3);
    out property <color> head: reduce-transparency ? (dark ? #151a1f : #ffffff) : (dark ? #161b22f0 : #f8fafcf0);
    out property <color> float: reduce-transparency ? (dark ? #1a1f27 : #ffffff) : (dark ? #1a1f27f2 : #fafbfdf2);
    // The float while the real blur draws under it, thin so the blur shows (60% light, 65% dark;
    // the spike's was 55%): the log drawer's. AA: the contrast test passes it over what the blur
    // leaves behind (the wallpaper, the panes and their tints), with the tints drawn on the pane,
    // down to 56% light and 53% dark; this keeps a margin.
    out property <color> glass-float: dark ? #1a1f27a6 : #fafbfd99;
    // The same under the modal dimmer (the sheet, and a dialog over it, with two dimmers behind):
    // the dimmer darkens what the blur hands the light pane, so AA needs 89% there (90% light).
    out property <color> glass-float-dim: dark ? #1a1f27a6 : #fafbfde6;
    // The modal backdrop behind the sheet and a dialog (.overlay::backdrop's dim).
    out property <color> dim: #080c1252;
    out property <color> field: dark ? #ffffff12 : #ffffff99;
    out property <color> sel: dark ? #ffffff1a : #6e7a9129;
    out property <color> edge: dark ? #ffffff21 : #ffffffb3;
    out property <color> hi: dark ? #ffffff29 : #ffffffe6;
    // .glass::before's top highlight, fading out at 38% of the pane. AA: dark at 10% where
    // style.css has 22%, which leaves mute at 4.2:1 on the dark float under it.
    out property <color> glass-hi: dark ? #ffffff1a : #ffffff38;
    // The first of --shadow's two layers.
    out property <color> shadow: dark ? #00000080 : #1e2a4024;

    // Text and lines.
    out property <color> fg: dark ? #e8edf2 : #121820;
    out property <color> mute: dark ? #b0bbc5 : #3f4a56;
    out property <color> path: dark ? #c3cdd6 : #2f3b47;
    // A field's placeholder (the browser's default ::placeholder grey): dimmer than mute, so it
    // never reads as a typed value. The fluent LineEdit's own is near white in the dark theme.
    // AA: dark #a5afb9 (was #939da7) so it holds on the Inspector's fields too, over the panel.
    out property <color> hint: dark ? #a5afb9 : #5c6670;
    out property <color> sep: dark ? #ffffff33 : #14203033;
    out property <color> line: dark ? #ffffff17 : #1420301a;
    out property <color> hover: dark ? #ffffff0f : #6e7a911a;
    out property <color> scroll: dark ? #ffffff33 : #14203038;
    out property <color> scroll-hover: dark ? #ffffff61 : #14203066;

    // Accents and tones. AA: every tone departs from style.css (light ones darker, dark err, warn,
    // info and done lighter) to pass 4.5:1 as text on every pane and on the field, sel, hover and
    // soft tints over it, and light --run #0e8fb0 is darkened under white button text. The soft
    // tints keep their tone's colour.
    out property <color> accent: dark ? #4cc7ad : #0b6956;
    out property <color> accent-fg: dark ? #06201a : #ffffff;
    out property <color> accent-soft: dark ? #4cc7ad29 : #0b695624;
    out property <color> accent-ring: dark ? #4cc7ad73 : #0b695661;
    out property <color> ok: dark ? #4fc98a : #196943;
    out property <color> warn: dark ? #e6a840 : #884f00;
    out property <color> err: dark ? #f09f97 : #a93126;
    // AA: style.css draws the Stop button's text #ffffff on --err, 2.8:1 in the dark theme.
    out property <color> err-fg: dark ? #2a0905 : #ffffff;
    out property <color> err-soft: dark ? #f09f9724 : #a931261f;
    out property <color> info: dark ? #85b8ea : #265e9c;
    // The status pill's tints (.pill.tone-info, .tone-ok: the tone at 18%). AA: as err-soft, 12%
    // light and 14% dark, so every tone stays 4.5:1 on them.
    out property <color> info-soft: dark ? #85b8ea24 : #265e9c1f;
    out property <color> ok-soft: dark ? #4fc98a24 : #1969431f;
    out property <color> done: dark ? #bda9ee : #6b45b5;
    out property <color> run: dark ? #3cc8e6 : #0b7f99;
    out property <color> run-fg: dark ? #04222b : #ffffff;
}

// A floating pane (.glass): the log drawer, the settings sheet and the dialog card. While
// `Theme.glass` holds, the real backdrop blur under the thinner glass-float; otherwise faked, as
// style.css fakes it, with the near opaque float. Either way the edge, a top highlight
// (.glass::before and the inset 1px line) and the shadow. Under Reduce transparency the float is
// solid and the edge, highlight and inset line stay, as style.css keeps `.glass` there.
export component GlassPane inherits Rectangle {
    // The blur drawn; out for the host's test that the panes follow `Theme.glass`.
    out property <length> blur: Theme.glass ? Theme.glass-blur : 0px;
    // Over the modal dimmer (the sheet and the dialog card): the thicker glass-float-dim.
    in property <bool> dimmed;
    border-radius: Theme.pane-radius;
    backdrop-blur: self.blur;
    background: !Theme.glass ? Theme.float : self.dimmed ? Theme.glass-float-dim : Theme.glass-float;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-blur: Theme.pane-shadow-blur;
    drop-shadow-offset-y: 18px;
    drop-shadow-color: Theme.shadow;
    Rectangle {
        y: 0;
        height: parent.height * 0.38;
        border-radius: parent.border-radius;
        background: @linear-gradient(180deg, Theme.glass-hi 0%, Theme.glass-hi.transparentize(100%) 100%);
    }
    // The inset line, between the top corners.
    Rectangle {
        x: parent.border-radius;
        y: 1px;
        width: parent.width - 2 * parent.border-radius;
        height: 1px;
        background: Theme.hi;
    }
    @children
}

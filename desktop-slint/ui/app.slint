// The Slint host's window (ADR-0017). Layout and bindings only: beyond fixed markup labels (as
// index.html has), every text it shows comes from the published View State through the host.
import "fonts/Onest-wght.ttf";
import "fonts/Unbounded-wght.ttf";
import "fonts/JetBrainsMono-wght.ttf";
import { Theme } from "theme.slint";
import { TitleBar } from "title-bar.slint";
import { FontProbe } from "font-probe.slint";
import { ScrollView } from "std-widgets.slint";
import { Mode, QueueFilter, QueueHead, QueuePane, QueueRow, RowMark, RowTone } from "queue.slint";
import { Inspector, InspectorPane, LibraryEntry, LibraryItem, Rung } from "inspector.slint";
import { ChipTexts, DraftForm, GearButton, PresetItem, PresetRow, SettingsSheet, Sheet, SheetLimits } from "settings.slint";
import { BottomBar, ConfirmDialog, DialogTexts, JobBar, StatusDot, StatusTone } from "jobs.slint";
import { LogBadge, LogDrawer, LogRow, LogSerials, LogTone, LogToggle } from "log.slint";

// FontProbe is test only; a .slint file cannot be compiled per cfg, so it ships (a few bytes).
export { Theme, FontProbe, Inspector, LibraryItem, Mode, QueueFilter, QueueHead, QueueRow, RowMark, RowTone, Rung, ChipTexts, DraftForm, PresetItem, Sheet, SheetLimits, DialogTexts, JobBar, StatusTone, LogBadge, LogRow, LogSerials, LogTone }

// Who opened the settings sheet, to take the focus back when it closes: a mode's gear, Run (after
// a refused Run), or nothing to give it back to.
enum Opener { none, remux-gear, extract-gear, run }

// A mode's tab in the sidebar (.task-row): its icon, its name over what it does and its status
// pill (a dot), then the gear that opens its settings sheet.
component ModeTab inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // The icon's path, in a 24x24 viewbox.
    in property <string> icon;
    in property <bool> active;
    in property <StatusTone> tone;
    in property <string> status;
    callback clicked();
    callback settings();
    // The sheet closed: the gear that opened it takes the focus back.
    public function focus-gear() {
        gear.focus();
    }
    // .task-row .nav's 44px at least, taller when the subtitle wraps (its 7px padding each side).
    height: max(44px, texts.preferred-height + 14px);
    border-radius: 8px;
    background: touch.has-hover || gear.hovered ? Theme.hover : active ? Theme.sel : transparent;
    tab-area := Rectangle {
        x: 0;
        width: parent.width - gear.width - 4px;
        accessible-role: tab;
        accessible-label: root.title;
        // The pill's text, which the webview's tab reads out unless idle.
        accessible-description: root.tone == StatusTone.idle ? "" : root.status;
        accessible-item-selected: root.active;
        accessible-action-default => { root.clicked(); }
        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
    gear := GearButton {
        x: parent.width - self.width - 4px;
        label: root.title + " settings";
        clicked => { root.settings(); }
    }
    // .nav: the icon, the texts, then the pill at the end.
    HorizontalLayout {
        x: 0;
        width: tab-area.width;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Path {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: Theme.fg;
            // The SVG's 2 in its 24-unit viewbox: a Path's stroke is not scaled with it.
            stroke-width: 2px * 16 / 24;
            stroke-line-cap: round;
            commands: root.icon;
            accessible-role: none;
        }
        texts := VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.fg;
                font-weight: 500;
                overflow: elide;
                accessible-role: none;
            }
            // Wraps onto a second line when narrow, as .nav-text small does.
            Text {
                text: root.subtitle;
                color: Theme.mute;
                font-size: 11px;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        // None while idle, taking no room, as `.status-idle { display: none }`.
        if root.tone != StatusTone.idle: StatusDot {
            y: (parent.height - self.height) / 2;
            tone: root.tone;
        }
    }
}

// The Library's "+ Open folder…" (.nav.lib-open): a muted nav row, locked while a batch runs.
// A sidebar group's heading (.side-group h2): 8px in, like the nav labels, and 4px above them.
component SideHeading inherits VerticalLayout {
    in property <string> text;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 4px;
    Text {
        text: root.text;
        color: Theme.mute;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.77px;
    }
}

component OpenFolderNav inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.75;
    accessible-role: button;
    accessible-label: "Open folder…";
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Text {
        x: 8px;
        text: "+ Open folder…";
        color: Theme.mute;
        font-weight: 500;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? default : not-allowed;
        clicked => { root.clicked(); }
    }
}

export component App inherits Window {
    // tauri.conf.json's window: 920x640, at least 760x520, frameless.
    title: "MKV Anime Batch";
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 520px;
    no-frame: true;
    // Transparent outside the rounded surface below, as the Linux webview window is.
    background: transparent;
    resize-border-width: root.maximized ? 0px : 6px;
    default-font-family: "Onest";
    default-font-size: 13px;

    // From the published View State: each mode's list header and rows, and whether a start or a
    // job holds the batch.
    in property <QueueHead> remux-head;
    in property <QueueHead> extract-head;
    in property <[QueueRow]> remux-rows;
    in property <[QueueRow]> extract-rows;
    in property <bool> busy;
    // A Run sent and not answered yet (the host's): Run and every control a batch locks stay
    // locked from the click on, as the start will lock them (job-controller.js `runPending`).
    in-out property <bool> run-pending;
    // What a batch locks: the settings, the presets, the subtitle controls and Open folder.
    out property <bool> locked: busy || run-pending;
    // Each mode's job controls: the bottom bar's and the tab's status pill. Before the first
    // publication, the markup's own labels (index.html).
    in property <JobBar> remux-job: { run-label: "Run remux", count-text: "Ready", clock: "Not started" };
    in property <JobBar> extract-job: { run-label: "Run extract", count-text: "Ready", clock: "Not started" };
    // Each mode's Run Log lines (the host keeps each model and its raw text for Copy), and its
    // error badge.
    in property <[LogRow]> remux-log;
    in property <[LogRow]> extract-log;
    in property <LogBadge> remux-log-badge;
    in property <LogBadge> extract-log-badge;
    // What the host last wrote into each mode's lines, which its console follows on.
    in property <LogSerials> remux-log-serials;
    in property <LogSerials> extract-log-serials;
    // The Log drawer is open.
    in-out property <bool> log-open;
    // The drawer's Copy: "Copied" or "Copy failed" for a while after a Copy (the host's).
    in property <string> log-copy-label: "Copy";
    // The confirm dialog shown, if open; the host bumps `dialog-serial` for each it shows.
    in property <bool> dialog-open;
    in property <DialogTexts> dialog;
    in property <int> dialog-serial;
    // Each mode's Library and Episode Inspector; the subtitle section's ladder and select entries
    // (remux only), and the language select's.
    in property <[LibraryItem]> remux-library;
    in property <[LibraryItem]> extract-library;
    in property <Inspector> remux-inspector;
    in property <Inspector> extract-inspector;
    in property <[Rung]> sub-ladder;
    in property <[string]> sub-options;
    // The value of each `sub-options` entry but the last ("Choose a file…"); for the host.
    in property <[string]> sub-values;
    in property <[string]> sub-languages;
    // The subtitle fields as typed (the remux inspector's); the host writes the published ones.
    in-out property <int> sub-choice;
    in-out property <int> sub-language;
    in-out property <string> sub-custom;
    in-out property <string> sub-title;
    in-out property <string> sub-offset;
    // A subtitle field edited since its last commit; the host clears it when it writes them.
    in-out property <bool> sub-dirty;
    // The mode shown.
    in-out property <Mode> mode;
    // A row picked for the Episode Inspector whose Inspect is not answered yet.
    in-out property <string> pending-inspect;
    // Each mode's list scroll offset (negative going down), kept across mode switches as the
    // webview's two lists keep theirs. The host puts it back at the top (`reveal`) when a card
    // replaces the rows; its bench (desktop-slint/benches/queue_scroll.rs) drives it.
    in-out property <length> remux-scroll;
    in-out property <length> extract-scroll;
    // Each mode's Settings Draft: as published, and as the sheet's fields hold it (the host writes
    // the published one back into the fields it may write).
    in property <DraftForm> remux-draft;
    in property <DraftForm> extract-draft;
    in-out property <DraftForm> remux-form;
    in-out property <DraftForm> extract-form;
    // The draft key the last Run of each mode could not read; empty for none.
    in property <string> remux-invalid;
    in property <string> extract-invalid;
    // The bitrate select's entries, the Preset Profiles, the worker and I/O job chips.
    in property <[string]> bitrates;
    in property <[PresetItem]> presets;
    in property <ChipTexts> chips;
    in property <SheetLimits> sheet-limits;
    // The settings sheet of the mode shown is open.
    in-out property <bool> sheet-open;
    // Who opened the sheet, to take the focus back.
    property <Opener> opener;

    // The shown mode's list asks; the host sends the Intent for `mode`.
    callback set-selected(id: string, selected: bool);
    callback set-all-selected(selected: bool);
    callback reorder(id: string, up: bool);
    callback inspect(id: string);
    callback set-filter(filter: QueueFilter);
    callback open-folder();
    // A Library entry: `release` is empty for the input folder (`root`).
    callback reveal-release(release: string, root: bool);
    // The subtitle select's entry `index` was picked, Reset, or a language, tag, title or offset
    // committed; the host sends the remux AssignSubtitle or ClearTrack.
    callback choose-subtitle(index: int);
    callback reset-subtitle();
    callback subtitle-options-changed();
    // The language select's entry `index` was picked.
    callback choose-language(index: int);
    // The language tag field was typed into; the host caps it.
    callback language-tag-edited(text: string);
    // Run, or Stop, of the mode shown; the host sends the Intent.
    callback run();
    callback stop();
    // Copy: the shown mode's Run Log, with its real paths, to the clipboard.
    callback copy-log();
    // The confirm dialog was answered: Clear cache or OK (`true`), Cancel or Esc.
    callback dialog-answered(confirmed: bool);
    callback close-window();
    // A Close whose teardown failed with `error`: the window stays open and a notice says why
    // (the host's, queued with the other dialogs).
    callback close-failed(error: string);
    // Through winit, not `minimized`: see the host's `minimize`.
    callback minimize-window();

    // Shows `mode` and opens its settings sheet with the cursor in the field of draft `key` (the
    // flagged field after a refused Run, so Run takes the focus back when it closes), or on Done
    // for an empty `key` or one it shows no field of. Already open, it moves the cursor there,
    // leaving the focused field first under the mode it belongs to (it changes if edited); a field
    // that keeps the focus is not left.
    public function open-sheet(mode: Mode, key: string) {
        if Sheet.focused != key || mode != root.mode {
            Sheet.leave(Sheet.focused);
        }
        root.leave-field();
        root.mode = mode;
        Sheet.focus-key = key;
        Sheet.focus-serial += 1;
        if !root.sheet-open {
            root.opener = key == "" ? Opener.none : Opener.run;
            root.sheet-open = true;
        }
    }

    // Done, a backdrop click or Esc: the focused field is left first (it changes if edited), as
    // a closing dialog blurs it, then the gear that opened the sheet takes the focus back. The
    // window's key scope takes it first, so Esc still reaches it with no opener to give it to.
    public function close-sheet() {
        Sheet.leave(Sheet.focused);
        root.sheet-open = false;
        keys.focus();
        if root.opener == Opener.remux-gear {
            remux-tab.focus-gear();
        } else if root.opener == Opener.extract-gear {
            extract-tab.focus-gear();
        } else if root.opener == Opener.run {
            bottom-bar.focus-run();
        }
    }

    function open-from-gear(mode: Mode) {
        root.open-sheet(mode, "");
        root.opener = mode == Mode.remux ? Opener.remux-gear : Opener.extract-gear;
    }

    // The confirm dialog closed over the sheet: the button that opened it takes the focus back,
    // and Done after a notice (OK alone), which no sheet button opened. With no sheet, the
    // window's key scope does, so Esc still reaches it (the removed dialog dropped the focus).
    changed dialog-open => {
        if !self.dialog-open {
            if self.sheet-open && self.dialog.notice {
                Sheet.done-focus-serial += 1;
            } else if self.sheet-open {
                Sheet.cache-focus-serial += 1;
            } else {
                keys.focus();
            }
        }
    }

    // Closes the Log drawer (Close, Esc); the Log toggle takes the focus when the drawer had it,
    // as app.js `setLogOpen` does.
    public function close-log() {
        if log-drawer.focus-inside {
            log-toggle.focus-toggle();
        }
        root.log-open = false;
    }
    // Scrolls `mode`'s list so its row `row` heads it.
    public function reveal(mode: Mode, row: int) {
        if mode == Mode.remux {
            remux-pane.reveal(row);
        } else {
            extract-pane.reveal(row);
        }
    }

    // The Library and Inspector of the mode shown.
    property <[LibraryItem]> library: root.mode == Mode.remux ? root.remux-library : root.extract-library;
    // style.css's .panes columns: narrower panes in a narrower window.
    property <length> side-width: root.width >= 1180px ? 220px : root.width >= 980px ? 200px : 196px;
    property <length> insp-width: root.width >= 1180px ? 320px : root.width >= 980px ? 280px : 248px;

    // A row picked: commits a typed subtitle field first, then marks the row at once and asks
    // the host.
    function pick(id: string) {
        root.leave-field();
        root.pending-inspect = id;
        root.inspect(id);
    }

    // Commits a subtitle field edited but not committed, as the webview's blur does before a
    // click lands. The custom controls (rows, chips, tabs, the Library, Open folder, Reset) take
    // no focus, so the field keeps it through their click and never commits on its own.
    function leave-field() {
        insp-pane.flush();
    }

    Rectangle {
        // Placed, so the window's size (which picks the pane widths above) is not its content's.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        // A maximized window is square, or the desktop shows through the corners.
        border-radius: root.maximized ? 0px : Theme.window-radius;
        clip: true;
        background: Theme.wall-base;

        // A few CJK glyphs, drawn all but transparent under the wallpaper, so the system's
        // fallback fonts load with the first frame and not in the frame where a CJK name first
        // scrolls in (#135). Each weight a CJK name is drawn at loads its own fallbacks (a row's
        // name and a release head at 600, the Inspector's title at 700). Drawn for good: a timer
        // from the window's creation can run out before a slow first frame (a cold start, the
        // bench), and the glyphs then never load early.
        for weight in [400, 600, 700]: Text {
            x: 0;
            y: 0;
            text: "あア漢药【】";
            font-weight: weight;
            color: #00000001;
            accessible-role: none;
        }

        // The wallpaper (--wall): three soft blobs over the base.
        Rectangle {
            x: -460px;
            y: -550px;
            width: 1100px;
            height: 1100px;
            background: @radial-gradient(circle, Theme.wall-a 0%, Theme.wall-a.transparentize(100%) 60%);
        }
        Rectangle {
            x: parent.width - 450px;
            y: parent.height - 450px;
            width: 900px;
            height: 900px;
            background: @radial-gradient(circle, Theme.wall-b 0%, Theme.wall-b.transparentize(100%) 58%);
        }
        Rectangle {
            x: parent.width * 0.58 - 380px;
            y: parent.height * 0.42 - 380px;
            width: 760px;
            height: 760px;
            background: @radial-gradient(circle, Theme.wall-c 0%, Theme.wall-c.transparentize(100%) 62%);
        }

        // Esc closes the Log drawer unless a dialog takes it (app.js's keydown): it bubbles here
        // from whatever has the focus outside the sheet and the dialog, and this scope holds the
        // focus from the start, so a key reaches it before anything took the focus.
        keys := FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape && root.log-open && !root.sheet-open && !root.dialog-open {
                    root.close-log();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                TitleBar {
                    close => { root.close-window(); }
                    minimize => { root.minimize-window(); }
                    toggle-maximize => { root.maximized = !root.maximized; }
                }

                HorizontalLayout {
                    // The sidebar (.side): the Pipeline's mode tabs, then the Library: its tree and Open
                    // folder. The presets are P4.
                    Rectangle {
                        width: root.side-width;
                        background: Theme.side;
                        // The sidebar scrolls, as .side's overflow does: a folder of many releases
                        // keeps Open folder reachable.
                        ScrollView {
                            content-width: self.visible-width;
                            content-height: side.preferred-height;
                            side := VerticalLayout {
                                width: parent.width;
                                padding-top: 14px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 2px;
                                alignment: start;
                                SideHeading { text: "PIPELINE"; }
                                remux-tab := ModeTab {
                                    title: "Remux";
                                    subtitle: "FLAC → Opus, mux subs";
                                    // A film strip.
                                    icon: "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M7 4v16 M17 4v16 M3 9h4 M3 15h4 M17 9h4 M17 15h4";
                                    active: root.mode == Mode.remux;
                                    tone: root.remux-job.tone;
                                    status: root.remux-job.status;
                                    clicked => {
                                        root.leave-field();
                                        root.mode = Mode.remux;
                                    }
                                    settings => { root.open-from-gear(Mode.remux); }
                                }
                                extract-tab := ModeTab {
                                    title: "Extract";
                                    subtitle: "Subs, fonts, chapters";
                                    // A screen with subtitle lines.
                                    icon: "M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M7 15h4 M13 15h4 M7 11h10";
                                    active: root.mode == Mode.extract;
                                    tone: root.extract-job.tone;
                                    status: root.extract-job.status;
                                    clicked => {
                                        root.leave-field();
                                        root.mode = Mode.extract;
                                    }
                                    settings => { root.open-from-gear(Mode.extract); }
                                }
                                // .side's 18px gap between groups, less the group's own 2px spacing.
                                Rectangle { height: 16px; }
                                SideHeading { text: "LIBRARY"; }
                                for item in root.library: LibraryEntry {
                                    item: item;
                                    clicked => {
                                        root.leave-field();
                                        root.reveal-release(item.release, item.root);
                                    }
                                }
                                OpenFolderNav {
                                    enabled: !root.locked;
                                    clicked => {
                                        root.leave-field();
                                        root.open-folder();
                                    }
                                }
                                // The Preset Profiles (#preset-list), remux's only.
                                if root.mode == Mode.remux: VerticalLayout {
                                    spacing: 2px;
                                    Rectangle { height: 16px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SideHeading { text: "PRESET"; }
                                        // .locked-label: a lock before the word.
                                        if root.busy: HorizontalLayout {
                                            spacing: 4px;
                                            Path {
                                                y: (parent.height - self.height) / 2;
                                                width: 11px;
                                                height: 11px;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                stroke: Theme.warn;
                                                stroke-width: 2.4px;
                                                stroke-line-cap: round;
                                                commands: "M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4";
                                                accessible-role: none;
                                            }
                                            Text {
                                                text: "Locked";
                                                color: Theme.warn;
                                                font-size: 11px;
                                                font-weight: 500;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    for item in root.presets: PresetRow {
                                        item: item;
                                        enabled: !root.locked;
                                        clicked => {
                                            root.leave-field();
                                            Sheet.pick-preset(item.id);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.line;
                        }
                    }

                    // One pane per mode, as the webview has one list per mode: both stay alive, so the
                    // hidden one keeps its scroll exactly (a ListView made again places its rows by an
                    // estimated row height).
                    Rectangle {
                        horizontal-stretch: 1;
                        remux-pane := QueuePane {
                            width: parent.width;
                            height: parent.height;
                            visible: root.mode == Mode.remux;
                            head: root.remux-head;
                            rows: root.remux-rows;
                            list-scroll <=> root.remux-scroll;
                            busy: root.busy;
                            locked: root.locked;
                            pending-inspect: root.pending-inspect;
                            set-selected(id, selected) => { root.set-selected(id, selected); }
                            set-all-selected(selected) => { root.set-all-selected(selected); }
                            reorder(id, up) => { root.reorder(id, up); }
                            inspect(id) => { root.pick(id); }
                            set-filter(filter) => {
                                root.leave-field();
                                root.set-filter(filter);
                            }
                            open-folder => {
                                root.leave-field();
                                root.open-folder();
                            }
                        }
                        extract-pane := QueuePane {
                            width: parent.width;
                            height: parent.height;
                            visible: root.mode == Mode.extract;
                            head: root.extract-head;
                            rows: root.extract-rows;
                            list-scroll <=> root.extract-scroll;
                            busy: root.busy;
                            locked: root.locked;
                            pending-inspect: root.pending-inspect;
                            set-selected(id, selected) => { root.set-selected(id, selected); }
                            set-all-selected(selected) => { root.set-all-selected(selected); }
                            reorder(id, up) => { root.reorder(id, up); }
                            inspect(id) => { root.pick(id); }
                            set-filter(filter) => {
                                root.leave-field();
                                root.set-filter(filter);
                            }
                            open-folder => {
                                root.leave-field();
                                root.open-folder();
                            }
                        }
                    }

                    // The Episode Inspector (.insp) of the mode shown; the subtitle section is remux's.
                    insp-pane := InspectorPane {
                        width: root.insp-width;
                        insp: root.mode == Mode.remux ? root.remux-inspector : root.extract-inspector;
                        ladder: root.sub-ladder;
                        options: root.sub-options;
                        languages: root.sub-languages;
                        busy: root.locked;
                        choice <=> root.sub-choice;
                        language <=> root.sub-language;
                        custom-language <=> root.sub-custom;
                        track-title <=> root.sub-title;
                        offset <=> root.sub-offset;
                        dirty <=> root.sub-dirty;
                        choose(index) => { root.choose-subtitle(index); }
                        choose-language(index) => { root.choose-language(index); }
                        language-tag-edited(text) => { root.language-tag-edited(text); }
                        // Reset takes no focus: a typed field commits first, then clears.
                        reset => {
                            root.leave-field();
                            root.reset-subtitle();
                        }
                        options-changed => { root.subtitle-options-changed(); }
                    }
                }

                // The bottom bar (.bar) of the mode shown.
                bottom-bar := BottomBar {
                    job: root.mode == Mode.remux ? root.remux-job : root.extract-job;
                    workers: root.chips.workers;
                    io-jobs: root.chips.io-jobs;
                    run-pending: root.run-pending;
                    // A typed subtitle field commits first, as the webview's blur does.
                    run => {
                        root.leave-field();
                        root.run();
                    }
                    stop => {
                        root.leave-field();
                        root.stop();
                    }
                    log-toggle := LogToggle {
                        y: (parent.height - self.height) / 2;
                        open: root.log-open;
                        badge: root.mode == Mode.remux ? root.remux-log-badge : root.extract-log-badge;
                        clicked => {
                            if root.log-open {
                                root.close-log();
                            } else {
                                root.log-open = true;
                            }
                        }
                    }
                }
            }
            // The Log drawer (.logdrawer) over the list, between the sidebar and the Inspector, above
            // the bar. Made from the start, so a console follows its newest line while the drawer
            // is closed.
            log-drawer := LogDrawer {
                x: root.side-width + 12px;
                y: root.height - bottom-bar.height - 12px - self.height;
                width: root.width - root.side-width - root.insp-width - 24px;
                height: root.height * 0.44;
                visible: root.log-open;
                title: root.mode == Mode.remux ? "Log · Remux" : "Log · Extract";
                copy-label: root.log-copy-label;
                copy => { root.copy-log(); }
                close => { root.close-log(); }
                remux-rows: root.remux-log;
                extract-rows: root.extract-log;
                remux-serials: root.remux-log-serials;
                extract-serials: root.extract-log-serials;
                extract: root.mode == Mode.extract;
            }
        }

        // The settings sheet of the mode shown (#settings-sheet), over a backdrop that covers the
        // window: a click on it or Esc closes the sheet.
        if root.sheet-open: Rectangle {
            background: #080c1252;
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.close-sheet();
                        return accept;
                    }
                    reject
                }
                TouchArea {
                    clicked => { root.close-sheet(); }
                }
                if root.mode == Mode.remux: SettingsSheet {
                    y: 36px;
                    width: min(580px, parent.width - 32px);
                    height: min(self.natural-height, parent.height - 72px);
                    title: "Remux settings";
                    remux: true;
                    form <=> root.remux-form;
                    invalid: root.remux-invalid;
                    out-placeholder: "Output folder next to the input";
                    bitrates: root.bitrates;
                    chips: root.chips;
                    limits: root.sheet-limits;
                    busy: root.busy;
                    locked: root.locked;
                    done => { root.close-sheet(); }
                }
                if root.mode == Mode.extract: SettingsSheet {
                    y: 36px;
                    width: min(580px, parent.width - 32px);
                    height: min(self.natural-height, parent.height - 72px);
                    title: "Extract settings";
                    form <=> root.extract-form;
                    invalid: root.extract-invalid;
                    out-placeholder: "Same folder as the input";
                    bitrates: root.bitrates;
                    chips: root.chips;
                    limits: root.sheet-limits;
                    busy: root.busy;
                    locked: root.locked;
                    done => { root.close-sheet(); }
                }
            }
        }

        // The confirm dialog (#confirm-modal), over the sheet too.
        if root.dialog-open: ConfirmDialog {
            texts: root.dialog;
            serial: root.dialog-serial;
            answered(confirmed) => { root.dialog-answered(confirmed); }
        }
    }
}

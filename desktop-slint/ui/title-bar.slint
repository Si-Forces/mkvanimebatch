// Redesign C's title bar (desktop-tauri/ui/index.html .titlebar): the traffic lights, the brand and
// a drag area behind them. Layout and bindings only; the host does what the buttons ask.
import { Theme } from "theme.slint";

component TrafficLight inherits Rectangle {
    in property <color> fill;
    in property <color> glyph-color;
    // An SVG path in an 8x8 box.
    in property <string> glyph;
    // Shows the glyph: the whole group is hovered, as on macOS.
    in property <bool> lit;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();

    width: 14px;
    height: 14px;
    border-radius: self.width / 2;
    background: touch.has-hover ? fill.brighter(0.12) : fill;
    border-width: 0.5px;
    border-color: #00000038;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.glyph;
        stroke: root.glyph-color;
        stroke-width: 1.8px;
        opacity: root.lit ? 1 : 0;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The theme toggle (.icon-btn.theme-btn): a sun in the light theme, a moon in the dark one. Takes
// the focus; Enter or Space toggles.
component ThemeButton inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: Theme.accent-ring;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: "Toggle theme";
    accessible-description: "Toggle light and dark theme (Ctrl+T)";
    accessible-action-default => { Theme.toggle(); }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover ? Theme.fg : Theme.mute;
        // The SVG's 2 in its 24-unit viewbox: a Path's stroke is not scaled with it.
        stroke-width: 2px * 17 / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: Theme.dark
            ? "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
            : "M16 12a4 4 0 1 1-8 0a4 4 0 1 1 8 0z M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4";
        accessible-role: none;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                Theme.toggle();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        // A left press takes the focus, as a browser's button does (the CapButton pattern).
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                keys.focus();
            }
        }
        clicked => { Theme.toggle(); }
    }
}

export component TitleBar inherits Rectangle {
    callback close();
    callback minimize();
    callback toggle-maximize();

    height: 46px;
    background: Theme.side;
    accessible-role: window-title-bar;
    accessible-label: "MKV Anime Batch";

    // Behind the buttons, so pressing one never starts a window move.
    WindowMoveArea {
        TouchArea {
            double-clicked => { root.toggle-maximize(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: 14px;
        spacing: 8px;
        property <bool> lit: close-button.has-hover || minimize-button.has-hover || maximize-button.has-hover;

        close-button := TrafficLight {
            fill: #ff5f57;
            glyph-color: #500000eb;
            glyph: "M2 2l4 4M6 2L2 6";
            lit: parent.lit;
            accessible-label: "Close window";
            clicked => { root.close(); }
        }
        minimize-button := TrafficLight {
            fill: #febc2e;
            glyph-color: #643200eb;
            glyph: "M1.6 4h4.8";
            lit: parent.lit;
            accessible-label: "Minimize window";
            clicked => { root.minimize(); }
        }
        maximize-button := TrafficLight {
            fill: #28c840;
            glyph-color: #004600eb;
            glyph: "M4 1.6v4.8M1.6 4h4.8";
            lit: parent.lit;
            accessible-label: "Maximize window";
            clicked => { root.toggle-maximize(); }
        }
    }

    ThemeButton {
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
    }

    // The brand, centred on the bar (.brand): the mark, then the name over "by Sifahaz".
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 10px;

        Image {
            width: 32px;
            height: 32px;
            source: @image-url("brand-mark.svg");
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "MKV Anime Batch";
                color: Theme.fg;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "by Sifahaz";
                color: Theme.mute;
                font-size: 11px;
                font-weight: 400;
                horizontal-alignment: center;
            }
        }
    }
}

// The window's custom controls (style.css `:focus-visible`, `title`): one pressable base that takes
// the focus from Tab and a left press, activates on Enter, Space, a click or a screen reader's
// action, draws the focus ring only for keyboard focus, shows its tooltip, and takes the focus back
// when a closing dialog or sheet asks for it. Layout and bindings only.
import { Theme } from "theme.slint";

export global Focus {
    // The last input was a key, or a Tab moved the focus: the focused control draws its ring, as
    // `:focus-visible` does. The window's key scope sets it on a key (not a modifier alone, nor a
    // shortcut); a left press anywhere clears it: on a control or the sheet's backdrop here, and
    // anywhere in the window from the host's winit event filter (main.rs `watch_window`).
    in-out property <bool> keyboard;
    // The `focus-key` of the Pressable with the focus; empty when none of them has it.
    in-out property <string> current;
    // `restore` asks the Pressable of `restore-key` to take the focus, unless it is disabled.
    in-out property <string> restore-key;
    in-out property <int> restore-serial;

    // The control a reset's new rows make that takes the focus as it is made (a moved episode's
    // Move up / Move down): `restore` reaches only the controls already made. Any control's
    // focus clears it, so one made later, scrolled into view, takes no focus.
    // ponytail: a field's focus does not clear it; a field then loses its focus to the control
    // if that row is first made later, scrolled into view.
    in-out property <string> follow-key;

    public function restore(key: string) {
        self.restore-key = key;
        self.restore-serial += 1;
    }
}

// style.css's `:focus-visible` outline: 2px of the accent, `gap` out from the control, which
// sizes it (`around`).
export component FocusRing inherits Rectangle {
    in property <length> gap: 2px;
    // The control's size and corner radius.
    in property <length> around-width;
    in property <length> around-height;
    in property <length> radius;
    x: -self.gap - 2px;
    y: -self.gap - 2px;
    width: self.around-width + 2 * (self.gap + 2px);
    height: self.around-height + 2 * (self.gap + 2px);
    border-radius: self.radius + self.gap + 2px;
    border-width: 2px;
    border-color: Theme.accent;
}

// A tooltip's card with plain text: a `Tooltip`'s own `text` is markdown.
export component TipCard inherits Rectangle {
    in property <string> text;
    // At most 320px wide: a longer text (a run's title with its path) wraps, anywhere in a path.
    width: min(tip-text.preferred-width + 16px, 320px);
    height: tip-text.preferred-height + 10px;
    border-radius: 6px;
    background: Theme.float;
    border-width: 1px;
    border-color: Theme.sep;
    tip-text := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: Theme.fg;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// A custom control: a button unless it says otherwise. Its content goes on top of the pointer
// area; the ring and the tooltip over it.
export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    // The hover tooltip (index.html's `title`), also the accessible description; none when empty.
    in property <string> tip;
    // Names the control for `Focus.restore`: its accessible label unless set; empty for never.
    in property <string> focus-key: self.accessible-label;
    // The ring's distance from the control (outline-offset).
    in property <length> ring-gap: 2px;
    // A click activates it; a stepper steps on the press instead (`pointer`).
    in property <bool> pointer-click: true;
    // A held Return activates it again at the key's repeat rate; a control that turns into
    // another (Run into Stop) or flips the window (the theme toggle) activates once a press.
    in property <bool> repeats: true;
    in property <MouseCursor> cursor: MouseCursor.pointer;
    callback clicked();
    // Every pointer event over it, after a left press took the focus.
    callback pointer(event: PointerEvent);
    out property <bool> focused: keys.has-focus;
    // The ring shows: focused, and the last input was a key.
    out property <bool> ring: keys.has-focus && Focus.keyboard;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;

    forward-focus: keys;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-description: root.tip;
    // A screen reader's activation focuses it first, as a click does, so a dialog or the sheet it
    // opens gives the focus back to it, and a typed field it leaves commits.
    protected function activate() {
        if root.enabled {
            keys.focus();
            root.clicked();
        }
    }
    accessible-action-default => { root.activate(); }

    // A disabled control is passed over: a programmatic focus would move on to the next one.
    property <int> restore: Focus.restore-serial;
    changed restore => {
        if root.enabled && root.focus-key != "" && Focus.restore-key == root.focus-key {
            keys.focus();
        }
    }
    init => {
        if root.enabled && Focus.follow-key != "" && Focus.follow-key == root.focus-key {
            keys.focus();
        }
    }
    // A row written in place can rename the focused control (a Library entry's release): its
    // focus-lost would then miss the old key, so `Focus.current` follows.
    changed focus-key => {
        if keys.has-focus {
            Focus.current = root.focus-key;
        }
    }

    keys := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            Focus.current = root.focus-key;
            Focus.follow-key = "";
            if reason == FocusReason.tab-navigation {
                Focus.keyboard = true;
            }
        }
        focus-lost => {
            if Focus.current == root.focus-key {
                Focus.current = "";
            }
        }
        // Return repeats while held, as on a browser's button, unless `repeats` is off; Space
        // activates once a press, as the browser's does on its release. A disabled scope that
        // keeps the focus still gets keys (Slint's `enabled` refuses only focus and presses).
        key-pressed(event) => {
            if !root.enabled {
                return reject;
            }
            if (event.text == Key.Return && (root.repeats || !event.repeat)) || (event.text == Key.Space && !event.repeat) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? root.cursor : not-allowed;
        // A left press takes the focus, as a browser's button does, without a ring.
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                Focus.keyboard = false;
                keys.focus();
            }
            root.pointer(event);
        }
        clicked => {
            if root.pointer-click {
                root.clicked();
            }
        }
    }
    @children
    if root.ring: FocusRing {
        gap: root.ring-gap;
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
    }
    if root.tip != "": Tooltip {
        TipCard {
            text: root.tip;
        }
    }
}

// A select (index.html's `<select>`, style.css `.field`): it shows the entry picked, and a click,
// Enter, Space or a screen reader's action opens the list of its entries under it. In the list the
// arrows move the highlight only; a click, Enter or Space picks an entry, Esc or a click outside
// closes it unchanged, and the select has the focus again. Closed, it takes neither the arrows nor
// the wheel, so the wheel scrolls the pane under it: only a pick changes it, as a WebKitGTK
// select's does. `picked` fires once a pick, for the entry shown too (a select sends no change for
// that one: its host passes over it).
export component Select inherits Pressable {
    in property <[string]> model;
    in-out property <int> current-index;
    callback picked(index: int);
    // The entry the list's arrows are on.
    property <int> highlight;
    property <length> entry-height: 28px;
    property <string> value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "";

    min-width: 0px;
    horizontal-stretch: 1;
    // The height of the fluent fields beside it.
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: self.hovered && root.enabled ? Theme.hover : Theme.field;
    opacity: root.enabled ? 1 : 0.75;
    cursor: default;
    // A held Return would open the list again as it closes.
    repeats: false;
    accessible-role: combobox;
    accessible-value: root.value;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-action-expand => { root.activate(); }
    clicked => {
        root.highlight = max(0, root.current-index);
        popup.show();
    }

    function pick(index: int) {
        popup.close();
        root.current-index = index;
        root.picked(index);
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.value;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        // A chevron down.
        Path {
            width: 10px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1L5 5L9 1";
            stroke: Theme.mute;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            accessible-role: none;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        // Not narrower than its entries need, within reason, as a native select's list.
        width: max(root.width, 180px);
        height: min(8, root.model.length) * root.entry-height + 10px;
        close-policy: close-on-click-outside;
        forward-focus: list-keys;
        list-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.highlight = max(0, root.highlight - 1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.highlight = min(root.model.length - 1, root.highlight + 1);
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Space) && !event.repeat {
                    root.pick(root.highlight);
                    return accept;
                }
                if event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                reject
            }
            Rectangle {
                border-radius: 8px;
                background: Theme.menu;
                border-width: 1px;
                border-color: Theme.sep;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000002e;
                list := Flickable {
                    x: 4px;
                    y: 5px;
                    width: parent.width - 8px;
                    height: parent.height - 10px;
                    content-height: root.model.length * root.entry-height;
                    // The highlighted entry stays in view.
                    property <int> highlight: root.highlight;
                    init => { self.follow(); }
                    changed highlight => { self.follow(); }
                    function follow() {
                        let top = root.highlight * root.entry-height;
                        if top + self.content-y < 0px {
                            self.content-y = -top;
                        } else if top + root.entry-height + self.content-y > self.height {
                            self.content-y = self.height - top - root.entry-height;
                        }
                    }
                    for entry[index] in root.model: Rectangle {
                        y: index * root.entry-height;
                        width: parent.width;
                        height: root.entry-height;
                        border-radius: 6px;
                        background: index == root.highlight ? Theme.sel : transparent;
                        accessible-role: list-item;
                        accessible-label: entry;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        accessible-item-selected: index == root.current-index;
                        accessible-action-default => { root.pick(index); }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: entry;
                            color: Theme.fg;
                            font-weight: index == root.current-index ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    root.highlight = index;
                                }
                            }
                            clicked => { root.pick(index); }
                        }
                    }
                }
            }
        }
    }
}

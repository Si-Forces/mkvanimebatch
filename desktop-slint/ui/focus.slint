// The window's custom controls (style.css `:focus-visible`, `title`): one pressable base that takes
// the focus from Tab and a left press, activates on Enter, Space, a click or a screen reader's
// action, draws the focus ring only for keyboard focus, shows its tooltip, and takes the focus back
// when a closing dialog or sheet asks for it. Layout and bindings only.
import { Theme } from "theme.slint";

export global Focus {
    // The last input was a key, or a Tab moved the focus: the focused control draws its ring, as
    // `:focus-visible` does. The window's key scope sets it on a key (not a modifier alone, nor a
    // shortcut); a left press anywhere clears it: on a control or the sheet's backdrop here, and
    // anywhere in the window from the host's winit event filter (main.rs `watch_window`).
    in-out property <bool> keyboard;
    // The `focus-key` of the Pressable with the focus; empty when none of them has it.
    in-out property <string> current;
    // `restore` asks the Pressable of `restore-key` to take the focus, unless it is disabled.
    in-out property <string> restore-key;
    in-out property <int> restore-serial;

    // The control a reset's new rows make that takes the focus as it is made (a moved episode's
    // Move up / Move down, or the row a Tab scrolls in): `restore` reaches only the controls
    // already made. Any control's focus clears it, and so do the first rows the reset makes
    // (QueuePane's `rows-made`), so one made later, scrolled into view, takes no focus.
    in-out property <string> follow-key;

    // The last Tab went backward (Shift+Tab), set by the window's key scope: the queue list's
    // entry stops each take the focus one way only.
    in-out property <bool> backward;

    // The window's settings sheet and confirm dialog are open (App's `sheet-open` and
    // `dialog-open`, bound to these). Like `<dialog>.showModal()`, the topmost one makes every
    // control outside it inert: a control in a lower layer than `modal` (Pressable's and
    // TextField's `layer`) does nothing, a screen reader's action included, takes no focus (a
    // screen reader's Focus action moves it on, to the next control that can take it), and reads
    // as disabled.
    in-out property <bool> sheet-open;
    in-out property <bool> dialog-open;
    // The topmost open layer: 0 the window, 1 the sheet, 2 the dialog (over the sheet too).
    out property <int> modal: dialog-open ? 2 : sheet-open ? 1 : 0;

    public function restore(key: string) {
        self.restore-key = key;
        self.restore-serial += 1;
    }
}

// style.css's `:focus-visible` outline: 2px of the accent, `gap` out from the control, which
// sizes it (`around`).
export component FocusRing inherits Rectangle {
    in property <length> gap: 2px;
    // The control's size and corner radius.
    in property <length> around-width;
    in property <length> around-height;
    in property <length> radius;
    // Square, as CSS draws an outline around a 0 radius: the text field sets it. Off, a control
    // with per-corner radii alone (a stepper's -/+) keeps its rounded ring.
    in property <bool> square;
    x: -self.gap - 2px;
    y: -self.gap - 2px;
    width: self.around-width + 2 * (self.gap + 2px);
    height: self.around-height + 2 * (self.gap + 2px);
    border-radius: self.square ? 0px : self.radius + self.gap + 2px;
    border-width: 2px;
    border-color: Theme.accent;
}

// Window-level hover tooltip state. Rendered by a single TipCard overlay at the top of App
// instead of Slint 1.19's built-in Tooltip (which wraps custom children in fluent's opaque 18x12
// ToolTipImpl box and clamps PopupWindow only to that 18x12 size).
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    // The pointer position last reported by the active TipArea/Pressable. App compares this
    // against its window-level pointer watcher so a card can never outlive a removed element.
    in-out property <length> owner-x;
    in-out property <length> owner-y;
    in-out property <int> serial;
    in-out property <bool> visible;
    // Which area shows it (`TipArea.owner`, "" for an unnamed one): the host hides the card of an
    // area a publication removes, and no other.
    in-out property <string> owner;

    public function hover(text: string, owner: string, x: length, y: length) {
        if text == "" {
            self.hide();
            return;
        }
        self.owner = owner;
        self.owner-x = x;
        self.owner-y = y;
        if self.visible && self.text == text {
            return;
        }
        self.visible = false;
        self.text = text;
        self.x = x;
        self.y = y;
        self.serial += 1;
    }

    public function show() {
        if self.text != "" {
            self.visible = true;
        }
    }

    public function leave(text: string) {
        if text != "" && self.text == text {
            self.hide();
        }
    }

    public function hide() {
        self.visible = false;
        self.text = "";
        self.owner = "";
    }
}

// A tooltip's card with plain text: placed 24px below the pointer hotspot (clearing a 24px cursor
// bounding box, matching GTK's placement below the cursor), horizontally centred on the pointer
// and clamped inside the window edges, flipping above the cursor only when it would overflow the
// window's bottom edge.
export component TipCard inherits Rectangle {
    in property <string> text;
    in property <length> pointer-x;
    in property <length> pointer-y;
    in property <length> window-width;
    in property <length> window-height;
    property <length> cursor-gap: 24px;
    property <length> edge-margin: 8px;
    // At most 440px wide so sentence tips (like complexity's 61 chars, ~364px in GTK) stay on
    // one line while longer run titles with paths still wrap.
    property <length> card-width: min(tip-text.preferred-width + 16px, 440px);
    property <length> card-height: tip-text.preferred-height + 10px;
    property <length> max-x: max(self.edge-margin, self.window-width - self.edge-margin - self.card-width);
    property <length> below-y: self.pointer-y + self.cursor-gap;

    x: clamp(self.pointer-x - self.card-width / 2, self.edge-margin, self.max-x);
    y: self.below-y + self.card-height <= self.window-height - self.edge-margin
        ? self.below-y
        : max(self.edge-margin, self.pointer-y - self.card-height - self.edge-margin);
    width: self.card-width;
    height: self.card-height;
    border-radius: 6px;
    background: Theme.float;
    border-width: 1px;
    border-color: Theme.sep;
    tip-text := Text {
        x: 8px;
        y: 5px;
        width: parent.width - 16px;
        text: root.text;
        color: Theme.fg;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// Hover tooltip region backed by an enabled TouchArea (`ForwardAndInterceptGrab`, accepts `Moved`,
// grabs `Pressed`, sets `mouse-cursor`, unlike Slint's internal `TooltipArea` which only observes
// via `ForwardAndObserve`). Rule: NEVER place a TipArea on top of an interactive control; wrap
// the control as its parent instead (as Field does), or place it only over non-interactive content.
export component TipArea inherits TouchArea {
    in property <string> tip;
    // Names the area for the host (`Tip.owner`): set where a publication can remove it.
    in property <string> owner;
    in property <bool> tip-quiet;
    property <bool> press-quiet;
    enabled: root.tip != "";

    public function suppress() {
        self.press-quiet = true;
        Tip.hide();
    }

    function sync-tip() {
        if self.has-hover && !root.tip-quiet && !self.press-quiet && root.tip != "" {
            Tip.hover(root.tip, root.owner, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }

    changed has-hover => {
        if self.has-hover {
            self.sync-tip();
        } else {
            self.press-quiet = false;
            Tip.leave(root.tip);
        }
    }
    changed mouse-x => { self.sync-tip(); }
    changed mouse-y => { self.sync-tip(); }
    changed tip-quiet => {
        if root.tip-quiet {
            Tip.leave(root.tip);
        }
    }
    changed tip => {
        if self.has-hover {
            if root.tip == "" {
                Tip.hide();
            } else {
                self.sync-tip();
            }
        }
    }
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            self.suppress();
        }
    }
    scroll-event(event) => {
        Tip.hide();
        reject
    }
    @children
}

// A custom control: a button unless it says otherwise. Its content goes on top of the pointer
// area; the ring and the tooltip over it.
export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    // The hover tooltip (index.html's `title`), also the accessible description; none when empty.
    in property <string> tip;
    // Names the control for `Focus.restore`: its accessible label unless set; empty for never.
    in property <string> focus-key: self.accessible-label;
    // The ring's distance from the control (outline-offset).
    in property <length> ring-gap: 2px;
    // A click activates it; a stepper steps on the press instead (`pointer`).
    in property <bool> pointer-click: true;
    // A held Return activates it again at the key's repeat rate; a control that turns into
    // another (Run into Stop) or flips the window (the theme toggle) activates once a press.
    in property <bool> repeats: true;
    // Return activates a button; a native checkbox toggles on Space only.
    in property <bool> activate-on-return: true;
    // Draw the keyboard focus ring around the whole Pressable; CheckBox draws it around its box.
    in property <bool> draws-ring: true;
    // The modal layer it sits in (`Focus.modal`): 1 in the settings sheet, 2 in the dialog.
    in property <int> layer;
    in property <MouseCursor> cursor: MouseCursor.pointer;
    callback clicked();
    // Every pointer event over it, after a left press took the focus.
    callback pointer(event: PointerEvent);
    out property <bool> focused: keys.has-focus;
    // The ring shows: focused, and the last input was a key.
    out property <bool> ring: keys.has-focus && Focus.keyboard;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    // Enabled, and not inert under a sheet or a dialog over its layer: it can act.
    out property <bool> live: root.enabled && root.layer >= Focus.modal;

    forward-focus: keys;
    accessible-role: button;
    accessible-enabled: root.live;
    accessible-description: root.tip;
    // A screen reader's activation focuses it first, as a click does, so a dialog or the sheet it
    // opens gives the focus back to it, and a typed field it leaves commits.
    protected function activate() {
        if root.live {
            keys.focus();
            root.clicked();
        }
    }
    accessible-action-default => { root.activate(); }

    // A disabled or inert control is passed over: a programmatic focus would move on to the next
    // one.
    property <int> restore: Focus.restore-serial;
    changed restore => {
        if root.live && root.focus-key != "" && Focus.restore-key == root.focus-key {
            keys.focus();
        }
    }
    init => {
        if root.live && Focus.follow-key != "" && Focus.follow-key == root.focus-key {
            keys.focus();
        }
    }
    // A row written in place can rename the focused control (a Library entry's release): its
    // focus-lost would then miss the old key, so `Focus.current` follows.
    changed focus-key => {
        if keys.has-focus {
            Focus.current = root.focus-key;
        }
    }

    keys := FocusScope {
        enabled: root.live;
        focus-gained(reason) => {
            Focus.current = root.focus-key;
            Focus.follow-key = "";
            if reason == FocusReason.tab-navigation {
                Focus.keyboard = true;
            }
        }
        focus-lost => {
            if Focus.current == root.focus-key {
                Focus.current = "";
            }
        }
        // Return repeats while held, as on a browser's button, unless `repeats` is off; Space
        // activates once a press, as the browser's does on its release. A disabled scope that
        // keeps the focus still gets keys (Slint's `enabled` refuses only focus and presses).
        key-pressed(event) => {
            if !root.live {
                return reject;
            }
            if (root.activate-on-return && event.text == Key.Return && (root.repeats || !event.repeat))
                || (event.text == Key.Space && !event.repeat) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TipArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? root.cursor : not-allowed;
        tip: root.tip;
        // A left press takes the focus, as a browser's button does, without a ring.
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                Focus.keyboard = false;
                keys.focus();
                self.suppress();
            }
            root.pointer(event);
        }
        clicked => {
            if root.pointer-click && root.live {
                root.clicked();
            }
        }
    }
    // A disabled TouchArea reports no hover; keep the tooltip and not-allowed cursor (style.css
    // `button:disabled`) active for disabled buttons (e.g. Run remux before a folder is open).
    // Always made, off while enabled: a button enabled under a resting pointer hides the card.
    TipArea {
        tip: root.enabled ? "" : root.tip;
        mouse-cursor: not-allowed;
    }
    @children
    if root.draws-ring && root.ring: FocusRing {
        gap: root.ring-gap;
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
    }
}

// A teal checkbox (.check-row): a 16px Theme.accent box beside its label, built on Pressable
// like the queue row's checkbox so it follows Theme.accent rather than fluent's system accent and
// respects modal layers (`layer`) without dimming under a dialog.
export component CheckBox inherits Pressable {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();

    height: max(20px, row.preferred-height);
    border-radius: 6px;
    cursor: default;
    activate-on-return: false;
    draws-ring: false;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    clicked => {
        root.checked = !root.checked;
        root.toggled();
    }

    row := HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            // style.css `input:disabled { opacity: .75; cursor: not-allowed }` applies to the
            // 16px checkbox input alone, not .check-row's label.
            box := Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.checked ? Theme.accent : Theme.field;
                border-width: root.checked ? 0px : 1.5px;
                border-color: Theme.mute;
                opacity: root.enabled ? 1 : Theme.disabled-opacity;
                if !root.enabled && root.layer >= Focus.modal: TouchArea {
                    mouse-cursor: not-allowed;
                }
                if root.checked: Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    fit: preserve;
                    commands: "M 1.5 5.2 L 4 7.7 L 8.5 2.5";
                    stroke: Theme.accent-fg;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    accessible-role: none;
                }
                if root.ring: FocusRing {
                    around-width: parent.width;
                    around-height: parent.height;
                    radius: parent.border-radius;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.text;
            color: Theme.fg;
            font-size: 13px;
            line-height-factor: Theme.lh-body;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

// A teal range slider (.range-row input[type="range"]): 4px Theme.line track, Theme.accent fill,
// 16px thumb, snapping drags, Left/Right/Up/Down/Home/End keys and screen-reader edits to whole
// steps, and respecting modal layers (`layer`) without dimming under a dialog.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value: minimum;
    in property <bool> enabled: true;
    in property <int> layer;
    in property <string> focus-key: self.accessible-label;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> ring: keys.has-focus && Focus.keyboard;
    out property <bool> live: root.enabled && root.layer >= Focus.modal;
    // Latched on a left press until the drag ends and the pointer leaves the slider, so a
    // wrapping Field's hover tooltip hides on press and stays hidden like a browser `title`.
    out property <bool> tip-quiet: touch.tip-quiet;
    callback changed(value: float);
    callback released(value: float);

    property <length> thumb-size: 16px;
    property <float> effective-step: root.step > 0 ? root.step : 1;
    property <float> span: max(0.0001, root.maximum - root.minimum);
    property <float> fraction: clamp((root.value - root.minimum) / self.span, 0, 1);

    function snap(raw: float) -> float {
        let clamped = clamp(raw, root.minimum, root.maximum);
        let s = root.effective-step;
        clamp(root.minimum + Math.round((clamped - root.minimum) / s) * s, root.minimum, root.maximum)
    }

    function set-stepped(raw: float) -> bool {
        if !root.live {
            return false;
        }
        let next = root.snap(raw);
        if next != root.value {
            root.value = next;
            root.changed(next);
            return true;
        }
        false
    }

    function end-drag(commit: bool) {
        if touch.dragging {
            touch.dragging = false;
            if !touch.has-hover {
                touch.tip-quiet = false;
            }
            // Only a pointer step counts: a form publication that moves the value while the
            // pointer is held is not the user's edit.
            if commit && touch.stepped {
                root.released(root.value);
            }
        }
    }

    function value-at(x: length) -> float {
        let track = root.width - root.thumb-size;
        let frac = track > 0px ? clamp((x - root.thumb-size / 2) / track, 0.0, 1.0) : 0.0;
        root.minimum + frac * (root.maximum - root.minimum)
    }

    min-width: 0px;
    horizontal-stretch: 1;
    height: 24px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    forward-focus: keys;
    accessible-role: slider;
    accessible-orientation: Orientation.horizontal;
    accessible-enabled: root.live;
    accessible-value: root.snap(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.effective-step;
    accessible-action-set-value(v) => {
        if root.live && v.is-float() && root.set-stepped(v.to-float()) {
            root.released(root.value);
        }
    }
    accessible-action-increment => {
        if root.live && root.set-stepped(root.snap(root.value) + root.effective-step) {
            root.released(root.value);
        }
    }
    accessible-action-decrement => {
        if root.live && root.set-stepped(root.snap(root.value) - root.effective-step) {
            root.released(root.value);
        }
    }

    property <int> restore: Focus.restore-serial;
    changed restore => {
        if root.live && root.focus-key != "" && Focus.restore-key == root.focus-key {
            keys.focus();
        }
    }
    changed live => {
        if !self.live {
            // Locked or inert mid-drag (batch started, dialog opened): end silently so we do not
            // emit `released` and send a second EditDraft after the lock.
            root.end-drag(false);
            keys.key-changed = false;
        }
    }

    keys := FocusScope {
        enabled: root.live;
        property <bool> key-changed;
        focus-gained(reason) => {
            Focus.current = root.focus-key;
            Focus.follow-key = "";
            if reason == FocusReason.tab-navigation {
                Focus.keyboard = true;
            }
        }
        focus-lost => {
            self.key-changed = false;
            if Focus.current == root.focus-key {
                Focus.current = "";
            }
        }
        key-pressed(event) => {
            if !root.live {
                return reject;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                if root.set-stepped(root.snap(root.value) + root.effective-step) {
                    self.key-changed = true;
                }
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                if root.set-stepped(root.snap(root.value) - root.effective-step) {
                    self.key-changed = true;
                }
                return accept;
            }
            if event.text == Key.Home {
                if root.set-stepped(root.minimum) {
                    self.key-changed = true;
                }
                return accept;
            }
            if event.text == Key.End {
                if root.set-stepped(root.maximum) {
                    self.key-changed = true;
                }
                return accept;
            }
            reject
        }
        key-released(event) => {
            if !root.live {
                return reject;
            }
            if event.text == Key.RightArrow || event.text == Key.LeftArrow
                || event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.Home || event.text == Key.End {
                if self.key-changed {
                    self.key-changed = false;
                    root.released(root.value);
                }
                return accept;
            }
            reject
        }
    }

    // Track (4px Theme.line).
    Rectangle {
        x: root.thumb-size / 2;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - root.thumb-size);
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
    }

    // Active fill (4px Theme.accent).
    Rectangle {
        x: root.thumb-size / 2;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - root.thumb-size) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }

    // Thumb (16px Theme.accent, no drop shadow: style.css has none on input[type="range"]).
    Rectangle {
        x: max(0px, parent.width - root.thumb-size) * root.fraction;
        y: (parent.height - self.height) / 2;
        width: root.thumb-size;
        height: root.thumb-size;
        border-radius: self.width / 2;
        background: Theme.accent;
    }

    touch := TouchArea {
        enabled: root.live;
        // style.css sets cursor: pointer on buttons only, not input[type="range"].
        mouse-cursor: MouseCursor.default;
        property <bool> dragging;
        // A pointer step of this drag changed the value.
        property <bool> stepped;
        // Where the pointer was last sampled: a release elsewhere (a touch) is a last step.
        property <length> sampled-x;
        out property <bool> tip-quiet;
        changed has-hover => {
            if !self.has-hover && !self.dragging {
                self.tip-quiet = false;
            }
        }
        pointer-event(event) => {
            // PointerEventKind.cancel arrives with button == other, so handle it before the
            // live/button filter; commit once only while still live (locking mid-drag ends
            // silently without a second EditDraft).
            if event.kind == PointerEventKind.cancel {
                root.end-drag(root.live);
                return;
            }
            if !root.live || event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                Focus.keyboard = false;
                keys.focus();
                self.tip-quiet = true;
                self.dragging = true;
                self.sampled-x = self.mouse-x;
                self.stepped = root.set-stepped(root.value-at(self.mouse-x));
            } else if event.kind == PointerEventKind.up {
                // Only a moved release steps: the value a form publication set stays otherwise.
                if self.dragging && self.mouse-x != self.sampled-x {
                    self.stepped = root.set-stepped(root.value-at(self.mouse-x)) || self.stepped;
                }
                root.end-drag(true);
            }
        }
        moved => {
            self.sampled-x = self.mouse-x;
            if self.dragging && root.live && root.set-stepped(root.value-at(self.mouse-x)) {
                self.stepped = true;
            }
        }
    }
    // A disabled TouchArea sets no cursor: style.css `input:disabled { cursor: not-allowed }`.
    if !root.enabled && root.layer >= Focus.modal: TouchArea {
        mouse-cursor: not-allowed;
    }

    if root.ring: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
    }
}

// A text field (index.html's `<input>`, style.css `.field`): a bare TextInput in the field's box,
// with no clear button, as the webview's input has none. Like the std LineEdit it has a context
// menu (Undo, Redo, Cut, Copy, Paste, Select All), keeps the caret in view by scrolling a text
// longer than the field, and reads as a text input with its value and placeholder. A screen
// reader's set-value edits it as an edit does, except in a disabled or read-only field; input-type
// does not filter it, the host checks the value as it checks any edit. The placeholder is drawn in
// Theme.hint while the field is empty, focused too, until a key is typed or an input method
// composes, as the webview's. Any focus draws the ring: `:focus-visible` matches a focused text
// input whether a key or the pointer focused it.
// It follows Slint's internal/compiler/widgets/common/lineedit-base.slint at 1.19.0 (unchanged
// since 45cb2b3): diff it against that file when the Slint pin moves.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> read-only <=> input.read-only;
    in property <string> font-family <=> input.font-family;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    in property <InputType> input-type <=> input.input-type;
    // The modal layer it sits in, as Pressable's: under a sheet or a dialog over it, it takes
    // neither the focus nor an edit, a screen reader's included.
    in property <int> layer;
    out property <bool> has-focus: input.has-focus;
    // Enabled, and not inert under a sheet or a dialog over its layer, as Pressable's.
    out property <bool> live: root.enabled && root.layer >= Focus.modal;
    callback edited(text: string);
    callback accepted(text: string);
    // .field's 1px border and 10px side padding, where the text and the placeholder start.
    property <length> inset: 11px;

    min-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: input.enabled;
    accessible-read-only: root.read-only;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    // A screen reader's edit, refused as typing is: not in a disabled, read-only or inert field.
    accessible-action-set-value(value) => {
        if !root.live || root.read-only {
            return;
        }
        root.text = value;
        root.edited(value);
    }
    accessible-action-set-selection-offsets(anchor, focus) => {
        if !root.live {
            return;
        }
        input.set-selection-offsets(anchor, focus);
    }

    if root.text == "" && input.preedit-text == "": Text {
        x: root.inset;
        width: max(0px, root.width - 2 * root.inset);
        text: root.placeholder;
        color: Theme.hint;
        font-family: input.font-family;
        font-size: input.font-size;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    // A menu open as the field turns inert (a dialog shows) closes, and its entries do nothing
    // then: the TextInput's edit functions do not check `enabled`. The menu's `enabled` and each
    // entry's check are a second guard behind `close()`, which cannot close a native menu
    // (Windows, macOS).
    changed live => {
        if !self.live {
            menu.close();
        }
    }
    menu := ContextMenuArea {
        enabled: root.live;
        Menu {
            if !root.read-only: MenuItem {
                title: "Undo";
                activated => {
                    if root.live {
                        input.undo();
                    }
                }
            }
            if !root.read-only: MenuItem {
                title: "Redo";
                activated => {
                    if root.live {
                        input.redo();
                    }
                }
            }
            if !root.read-only: MenuSeparator { }
            if !root.read-only: MenuItem {
                title: "Cut";
                enabled: input.has-selection;
                activated => {
                    if root.live {
                        input.cut();
                    }
                }
            }
            MenuItem {
                title: "Copy";
                enabled: input.has-selection;
                activated => {
                    if root.live {
                        input.copy();
                    }
                }
            }
            if !root.read-only: MenuItem {
                title: "Paste";
                activated => {
                    if root.live {
                        input.paste();
                    }
                }
            }
            MenuItem {
                title: "Select All";
                enabled: root.text != "";
                activated => {
                    if root.live {
                        input.select-all();
                    }
                }
            }
        }

        // A press in the side padding focuses the field too, as anywhere in an `<input>`'s box:
        // the clip below takes only the presses inside it.
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    input.focus();
                }
            }
        }

        // The text inside the inset, clipped: a text longer than the field slides so the caret
        // stays in view. The clip is at least 1px wide: an empty clip hides the TextInput, which
        // then cannot take the focus.
        Rectangle {
            x: root.inset;
            width: max(1px, parent.width - 2 * root.inset);
            clip: true;
            input := TextInput {
                enabled: root.live;
                // How far the text slid left (zero or negative) to keep the caret in view.
                property <length> scroll;
                // Where the caret can sit, from the clip's left edge.
                property <length> room: parent.width - self.text-cursor-width;
                x: self.scroll.clamp(self.room - self.width, 0px);
                width: max(1px, self.room, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                font-size: 12px;
                color: Theme.fg;
                selection-background-color: Theme.accent-ring;
                selection-foreground-color: Theme.fg;
                // The field reads as the text input.
                accessible-role: none;
                // The least slide that brings the caret, at `at.x + scroll`, back within 0..room.
                cursor-position-changed(at) => {
                    self.scroll = self.scroll.clamp(-at.x, self.room - at.x);
                }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }

    if root.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
        square: root.border-radius <= 0px;
    }
}

// A select (index.html's `<select>`, style.css `.field`): it shows the entry picked, and a click,
// Enter, Space or a screen reader's action opens the list of its entries under it. In the list the
// arrows move the highlight only; a click, Enter or Space picks an entry, Esc or a click outside
// closes it unchanged, and the select has the focus again. Closed, it takes neither the arrows nor
// the wheel, so the wheel scrolls the pane under it, as over a WebKitGTK select; that select steps
// on the arrows, this one deliberately does not: only a pick changes it. `picked` fires once a
// pick, for the entry shown too, `changed` false for that one (a select sends no change for it:
// its host passes over it). Disabled or inert (`live`), or with no entry, it picks nothing, and a
// list open as it is disabled or made inert closes.
export component Select inherits Pressable {
    in property <[string]> model;
    in-out property <int> current-index;
    callback picked(index: int, changed: bool);
    // The entry the list's arrows are on.
    property <int> highlight;
    property <length> entry-height: 28px;
    property <string> value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "";

    min-width: 0px;
    horizontal-stretch: 1;
    // style.css `.field`, as the text fields beside it.
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    cursor: default;
    // A held Return would open the list again as it closes.
    repeats: false;
    accessible-role: combobox;
    accessible-value: root.value;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-action-expand => { root.activate(); }
    clicked => {
        if root.model.length > 0 {
            root.highlight = max(0, root.current-index);
            popup.show();
        }
    }
    changed live => {
        if !root.live {
            popup.close();
        }
    }

    function pick(index: int) {
        popup.close();
        if root.live && index >= 0 && index < root.model.length {
            let changed = index != root.current-index;
            root.current-index = index;
            root.picked(index, changed);
        }
    }

    HorizontalLayout {
        // .field's 1px border and 10px padding.
        padding-left: 11px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.value;
            color: Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        // A chevron down.
        Path {
            width: 10px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1L5 5L9 1";
            stroke: Theme.mute;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            accessible-role: none;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        // Not narrower than its entries need, within reason, as a native select's list.
        width: max(root.width, 180px);
        height: min(8, root.model.length) * root.entry-height + 10px;
        close-policy: close-on-click-outside;
        forward-focus: list-keys;
        // A screen reader's list, whose focus follows the highlight (as Slint's ListView's
        // `focus-item`): the arrows are read out, entry by entry.
        list-keys := FocusScope {
            accessible-role: list;
            accessible-delegate-focus: root.highlight;
            accessible-item-count: root.model.length;
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.highlight = max(0, root.highlight - 1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.highlight = min(root.model.length - 1, root.highlight + 1);
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Space) && !event.repeat {
                    root.pick(root.highlight);
                    return accept;
                }
                if event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                reject
            }
            Rectangle {
                border-radius: 8px;
                background: Theme.menu;
                border-width: 1px;
                border-color: Theme.sep;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000002e;
                Flickable {
                    x: 4px;
                    y: 5px;
                    width: parent.width - 8px;
                    height: parent.height - 10px;
                    content-height: root.model.length * root.entry-height;
                    // The highlighted entry stays in view.
                    property <int> highlight: root.highlight;
                    init => { self.follow(); }
                    changed highlight => { self.follow(); }
                    function follow() {
                        let top = root.highlight * root.entry-height;
                        if top + self.content-y < 0px {
                            self.content-y = -top;
                        } else if top + root.entry-height + self.content-y > self.height {
                            self.content-y = self.height - top - root.entry-height;
                        }
                    }
                    for entry[index] in root.model: Rectangle {
                        y: index * root.entry-height;
                        width: parent.width;
                        height: root.entry-height;
                        border-radius: 6px;
                        background: index == root.highlight ? Theme.sel : transparent;
                        accessible-role: list-item;
                        accessible-label: entry;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        // The highlighted entry is the selected one, as in a native select's list.
                        accessible-item-selected: index == root.highlight;
                        accessible-action-default => { root.pick(index); }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: entry;
                            color: Theme.fg;
                            font-size: 12px;
                            font-weight: index == root.current-index ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    root.highlight = index;
                                }
                            }
                            clicked => { root.pick(index); }
                        }
                    }
                }
            }
        }
    }
}

// The window's custom controls (style.css `:focus-visible`, `title`): one pressable base that takes
// the focus from Tab and a left press, activates on Enter, Space, a click or a screen reader's
// action, draws the focus ring only for keyboard focus, shows its tooltip, and takes the focus back
// when a closing dialog or sheet asks for it. Layout and bindings only.
import { Theme } from "theme.slint";

export global Focus {
    // The last input was a key, or a Tab moved the focus: the focused control draws its ring, as
    // `:focus-visible` does. The window's key scope sets it on a key (not a modifier alone, nor a
    // shortcut); a left press anywhere clears it: on a control or the sheet's backdrop here, and
    // anywhere in the window from the host's winit event filter (main.rs `watch_window`).
    in-out property <bool> keyboard;
    // The `focus-key` of the Pressable with the focus; empty when none of them has it.
    in-out property <string> current;
    // `restore` asks the Pressable of `restore-key` to take the focus, unless it is disabled.
    in-out property <string> restore-key;
    in-out property <int> restore-serial;

    // The control a reset's new rows make that takes the focus as it is made (a moved episode's
    // Move up / Move down): `restore` reaches only the controls already made. Any control's
    // focus clears it, and so do the first rows the reset makes (QueuePane's `rows-made`), so one
    // made later, scrolled into view, takes no focus.
    in-out property <string> follow-key;

    // The last Tab went backward (Shift+Tab), set by the window's key scope: the queue list's
    // entry stops each take the focus one way only.
    in-out property <bool> backward;

    // The window's settings sheet and confirm dialog are open (App's `sheet-open` and
    // `dialog-open`, bound to these). Like `<dialog>.showModal()`, the topmost one makes every
    // control outside it inert: a control in a lower layer than `modal` (Pressable's and
    // TextField's `layer`) does nothing, a screen reader's action included, and reads as disabled.
    in-out property <bool> sheet-open;
    in-out property <bool> dialog-open;
    // The topmost open layer: 0 the window, 1 the sheet, 2 the dialog (over the sheet too).
    out property <int> modal: dialog-open ? 2 : sheet-open ? 1 : 0;

    public function restore(key: string) {
        self.restore-key = key;
        self.restore-serial += 1;
    }
}

// style.css's `:focus-visible` outline: 2px of the accent, `gap` out from the control, which
// sizes it (`around`).
export component FocusRing inherits Rectangle {
    in property <length> gap: 2px;
    // The control's size and corner radius.
    in property <length> around-width;
    in property <length> around-height;
    in property <length> radius;
    // Square, as CSS draws an outline around a 0 radius: the text field sets it. Off, a control
    // with per-corner radii alone (a stepper's -/+) keeps its rounded ring.
    in property <bool> square;
    x: -self.gap - 2px;
    y: -self.gap - 2px;
    width: self.around-width + 2 * (self.gap + 2px);
    height: self.around-height + 2 * (self.gap + 2px);
    border-radius: self.square ? 0px : self.radius + self.gap + 2px;
    border-width: 2px;
    border-color: Theme.accent;
}

// A tooltip's card with plain text: a `Tooltip`'s own `text` is markdown.
export component TipCard inherits Rectangle {
    in property <string> text;
    // At most 320px wide: a longer text (a run's title with its path) wraps, anywhere in a path.
    width: min(tip-text.preferred-width + 16px, 320px);
    height: tip-text.preferred-height + 10px;
    border-radius: 6px;
    background: Theme.float;
    border-width: 1px;
    border-color: Theme.sep;
    tip-text := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: Theme.fg;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// A custom control: a button unless it says otherwise. Its content goes on top of the pointer
// area; the ring and the tooltip over it.
export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    // The hover tooltip (index.html's `title`), also the accessible description; none when empty.
    in property <string> tip;
    // Names the control for `Focus.restore`: its accessible label unless set; empty for never.
    in property <string> focus-key: self.accessible-label;
    // The ring's distance from the control (outline-offset).
    in property <length> ring-gap: 2px;
    // A click activates it; a stepper steps on the press instead (`pointer`).
    in property <bool> pointer-click: true;
    // A held Return activates it again at the key's repeat rate; a control that turns into
    // another (Run into Stop) or flips the window (the theme toggle) activates once a press.
    in property <bool> repeats: true;
    // The modal layer it sits in (`Focus.modal`): 1 in the settings sheet, 2 in the dialog.
    in property <int> layer;
    in property <MouseCursor> cursor: MouseCursor.pointer;
    callback clicked();
    // Every pointer event over it, after a left press took the focus.
    callback pointer(event: PointerEvent);
    out property <bool> focused: keys.has-focus;
    // The ring shows: focused, and the last input was a key.
    out property <bool> ring: keys.has-focus && Focus.keyboard;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    // Enabled, and not inert under a sheet or a dialog over its layer: it can act.
    out property <bool> live: root.enabled && root.layer >= Focus.modal;

    forward-focus: keys;
    accessible-role: button;
    accessible-enabled: root.live;
    accessible-description: root.tip;
    // A screen reader's activation focuses it first, as a click does, so a dialog or the sheet it
    // opens gives the focus back to it, and a typed field it leaves commits.
    protected function activate() {
        if root.live {
            keys.focus();
            root.clicked();
        }
    }
    accessible-action-default => { root.activate(); }

    // A disabled control is passed over: a programmatic focus would move on to the next one.
    property <int> restore: Focus.restore-serial;
    changed restore => {
        if root.enabled && root.focus-key != "" && Focus.restore-key == root.focus-key {
            keys.focus();
        }
    }
    init => {
        if root.enabled && Focus.follow-key != "" && Focus.follow-key == root.focus-key {
            keys.focus();
        }
    }
    // A row written in place can rename the focused control (a Library entry's release): its
    // focus-lost would then miss the old key, so `Focus.current` follows.
    changed focus-key => {
        if keys.has-focus {
            Focus.current = root.focus-key;
        }
    }

    keys := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            Focus.current = root.focus-key;
            Focus.follow-key = "";
            if reason == FocusReason.tab-navigation {
                Focus.keyboard = true;
            }
        }
        focus-lost => {
            if Focus.current == root.focus-key {
                Focus.current = "";
            }
        }
        // Return repeats while held, as on a browser's button, unless `repeats` is off; Space
        // activates once a press, as the browser's does on its release. A disabled scope that
        // keeps the focus still gets keys (Slint's `enabled` refuses only focus and presses).
        key-pressed(event) => {
            if !root.live {
                return reject;
            }
            if (event.text == Key.Return && (root.repeats || !event.repeat)) || (event.text == Key.Space && !event.repeat) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? root.cursor : not-allowed;
        // A left press takes the focus, as a browser's button does, without a ring.
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                Focus.keyboard = false;
                keys.focus();
            }
            root.pointer(event);
        }
        clicked => {
            if root.pointer-click && root.live {
                root.clicked();
            }
        }
    }
    @children
    if root.ring: FocusRing {
        gap: root.ring-gap;
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
    }
    if root.tip != "": Tooltip {
        TipCard {
            text: root.tip;
        }
    }
}

// A text field (index.html's `<input>`, style.css `.field`): a bare TextInput in the field's box,
// with no clear button, as the webview's input has none. Like the std LineEdit it has a context
// menu (Undo, Redo, Cut, Copy, Paste, Select All), keeps the caret in view by scrolling a text
// longer than the field, and reads as a text input with its value and placeholder. A screen
// reader's set-value edits it as an edit does, except in a disabled or read-only field; input-type
// does not filter it, the host checks the value as it checks any edit. The placeholder is drawn in
// Theme.hint while the field is empty, focused too, until a key is typed or an input method
// composes, as the webview's. Any focus draws the ring: `:focus-visible` matches a focused text
// input whether a key or the pointer focused it.
// It follows Slint's internal/compiler/widgets/common/lineedit-base.slint at 45cb2b3: diff it
// against that file when the Slint pin moves.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <string> font-family <=> input.font-family;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    in property <InputType> input-type <=> input.input-type;
    // The modal layer it sits in, as Pressable's: under a sheet or a dialog over it, a screen
    // reader cannot edit it.
    in property <int> layer;
    out property <bool> has-focus: input.has-focus;
    callback edited(text: string);
    callback accepted(text: string);
    // .field's 1px border and 10px side padding, where the text and the placeholder start.
    property <length> inset: 11px;

    min-width: 0px;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;
    opacity: root.enabled ? 1 : 0.75;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled && root.layer >= Focus.modal;
    accessible-read-only: root.read-only;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    // A screen reader's edit, refused as typing is: not in a disabled, read-only or inert field.
    accessible-action-set-value(value) => {
        if !root.enabled || root.read-only || root.layer < Focus.modal {
            return;
        }
        root.text = value;
        root.edited(value);
    }
    accessible-action-set-selection-offsets(anchor, focus) => {
        input.set-selection-offsets(anchor, focus);
    }

    if root.text == "" && input.preedit-text == "": Text {
        x: root.inset;
        width: max(0px, root.width - 2 * root.inset);
        text: root.placeholder;
        color: Theme.hint;
        font-family: input.font-family;
        font-size: input.font-size;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            if !root.read-only: MenuItem {
                title: "Undo";
                activated => { input.undo(); }
            }
            if !root.read-only: MenuItem {
                title: "Redo";
                activated => { input.redo(); }
            }
            if !root.read-only: MenuSeparator { }
            if !root.read-only: MenuItem {
                title: "Cut";
                enabled: input.has-selection;
                activated => { input.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: input.has-selection;
                activated => { input.copy(); }
            }
            if !root.read-only: MenuItem {
                title: "Paste";
                activated => { input.paste(); }
            }
            MenuItem {
                title: "Select All";
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }

        // A press in the side padding focuses the field too, as anywhere in an `<input>`'s box:
        // the clip below takes only the presses inside it.
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    input.focus();
                }
            }
        }

        // The text inside the inset, clipped: a text longer than the field slides so the caret
        // stays in view. The clip is at least 1px wide: an empty clip hides the TextInput, which
        // then cannot take the focus.
        Rectangle {
            x: root.inset;
            width: max(1px, parent.width - 2 * root.inset);
            clip: true;
            input := TextInput {
                // How far the text slid left (zero or negative) to keep the caret in view.
                property <length> scroll;
                // Where the caret can sit, from the clip's left edge.
                property <length> room: parent.width - self.text-cursor-width;
                x: self.scroll.clamp(self.room - self.width, 0px);
                width: max(1px, self.room, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                font-size: 12px;
                color: Theme.fg;
                selection-background-color: Theme.accent-ring;
                selection-foreground-color: Theme.fg;
                // The field reads as the text input.
                accessible-role: none;
                // The least slide that brings the caret, at `at.x + scroll`, back within 0..room.
                cursor-position-changed(at) => {
                    self.scroll = self.scroll.clamp(-at.x, self.room - at.x);
                }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }

    if root.has-focus: FocusRing {
        around-width: root.width;
        around-height: root.height;
        radius: root.border-radius;
        square: root.border-radius <= 0px;
    }
}

// A select (index.html's `<select>`, style.css `.field`): it shows the entry picked, and a click,
// Enter, Space or a screen reader's action opens the list of its entries under it. In the list the
// arrows move the highlight only; a click, Enter or Space picks an entry, Esc or a click outside
// closes it unchanged, and the select has the focus again. Closed, it takes neither the arrows nor
// the wheel, so the wheel scrolls the pane under it, as over a WebKitGTK select; that select steps
// on the arrows, this one deliberately does not: only a pick changes it. `picked` fires once a
// pick, for the entry shown too, `changed` false for that one (a select sends no change for it:
// its host passes over it). Disabled or inert (`live`), or with no entry, it picks nothing, and a
// list open as it is disabled or made inert closes.
export component Select inherits Pressable {
    in property <[string]> model;
    in-out property <int> current-index;
    callback picked(index: int, changed: bool);
    // The entry the list's arrows are on.
    property <int> highlight;
    property <length> entry-height: 28px;
    property <string> value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "";

    min-width: 0px;
    horizontal-stretch: 1;
    // style.css `.field`, as the text fields beside it.
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: self.hovered && root.enabled ? Theme.hover : Theme.field;
    opacity: root.enabled ? 1 : 0.75;
    cursor: default;
    // A held Return would open the list again as it closes.
    repeats: false;
    accessible-role: combobox;
    accessible-value: root.value;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-action-expand => { root.activate(); }
    clicked => {
        if root.model.length > 0 {
            root.highlight = max(0, root.current-index);
            popup.show();
        }
    }
    changed live => {
        if !root.live {
            popup.close();
        }
    }

    function pick(index: int) {
        popup.close();
        if root.live && index >= 0 && index < root.model.length {
            let changed = index != root.current-index;
            root.current-index = index;
            root.picked(index, changed);
        }
    }

    HorizontalLayout {
        // .field's 1px border and 10px padding.
        padding-left: 11px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.value;
            color: Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        // A chevron down.
        Path {
            width: 10px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1L5 5L9 1";
            stroke: Theme.mute;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            accessible-role: none;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        // Not narrower than its entries need, within reason, as a native select's list.
        width: max(root.width, 180px);
        height: min(8, root.model.length) * root.entry-height + 10px;
        close-policy: close-on-click-outside;
        forward-focus: list-keys;
        // A screen reader's list, whose focus follows the highlight (as Slint's ListView's
        // `focus-item`): the arrows are read out, entry by entry.
        list-keys := FocusScope {
            accessible-role: list;
            accessible-delegate-focus: root.highlight;
            accessible-item-count: root.model.length;
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.highlight = max(0, root.highlight - 1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.highlight = min(root.model.length - 1, root.highlight + 1);
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Space) && !event.repeat {
                    root.pick(root.highlight);
                    return accept;
                }
                if event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                reject
            }
            Rectangle {
                border-radius: 8px;
                background: Theme.menu;
                border-width: 1px;
                border-color: Theme.sep;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #0000002e;
                Flickable {
                    x: 4px;
                    y: 5px;
                    width: parent.width - 8px;
                    height: parent.height - 10px;
                    content-height: root.model.length * root.entry-height;
                    // The highlighted entry stays in view.
                    property <int> highlight: root.highlight;
                    init => { self.follow(); }
                    changed highlight => { self.follow(); }
                    function follow() {
                        let top = root.highlight * root.entry-height;
                        if top + self.content-y < 0px {
                            self.content-y = -top;
                        } else if top + root.entry-height + self.content-y > self.height {
                            self.content-y = self.height - top - root.entry-height;
                        }
                    }
                    for entry[index] in root.model: Rectangle {
                        y: index * root.entry-height;
                        width: parent.width;
                        height: root.entry-height;
                        border-radius: 6px;
                        background: index == root.highlight ? Theme.sel : transparent;
                        accessible-role: list-item;
                        accessible-label: entry;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        // The highlighted entry is the selected one, as in a native select's list.
                        accessible-item-selected: index == root.highlight;
                        accessible-action-default => { root.pick(index); }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: entry;
                            color: Theme.fg;
                            font-weight: index == root.current-index ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    root.highlight = index;
                                }
                            }
                            clicked => { root.pick(index); }
                        }
                    }
                }
            }
        }
    }
}

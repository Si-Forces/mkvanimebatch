// Redesign C's settings sheet (desktop-tauri/ui/index.html #settings-sheet, style.css .sheet), the
// sidebar's Preset Profiles (.preset-row) and the gear buttons (.task-settings-btn). Layout and
// bindings only: the host (desktop-slint/src/settings.rs) maps the published Settings Draft, sends
// the edits and holds every rule: which field a publication writes back, the steppers' repeat, the
// hints and the preset texts.
import { Button, CheckBox, ScrollView, Slider } from "std-widgets.slint";
import { GlassPane, Theme } from "theme.slint";
import { CapButton, PillButton } from "jobs.slint";
import { Focus, Pressable, Select, TextField, TipCard } from "focus.slint";

// One mode's Settings Draft as the sheet shows it, every field as typed but the two checkboxes.
// The remux-only fields stay empty in extract's. `bitrate` is the index of the bitrate select's
// entry (-1: none of them).
export struct DraftForm {
    input-dir: string,
    out-dir: string,
    fonts-dir: string,
    assets-dir: string,
    bitrate: int,
    complexity: string,
    sub-offset: string,
    workers: string,
    io-jobs: string,
    ffmpeg-threads: string,
    dry-run: bool,
    no-cache: bool,
}

// One Preset Profile row: its name over the encode it sets, `active` when the remux draft is on it.
export struct PresetItem {
    id: string,
    name: string,
    sub: string,
    active: bool,
    a11y: string,
}

// The sheet's limits from the core's ranges: the complexity slider's, and the tooltips of the
// number fields that name theirs.
export struct SheetLimits {
    complexity-min: int,
    complexity-max: int,
    complexity-tip: string,
    workers-tip: string,
    io-jobs-tip: string,
    ffmpeg-threads-tip: string,
}

// The worker and I/O job chips, and the placeholders of the Workers and Disk I/O fields.
export struct ChipTexts {
    workers: string,
    io-jobs: string,
    workers-hint: string,
    io-jobs-hint: string,
}

// The sheet's fields talk to the host through this global. Each field is named by its draft key
// (`input_dir`, `complexity`, …), and the sheet shows the mode the window shows.
export global Sheet {
    // The key of the field with the focus, which a publication leaves alone; empty for none.
    in-out property <string> focused;
    // The focused field was edited since its last change (a webview `change`).
    in-out property <bool> changed-since;
    // The field to put the cursor in when the sheet opens, or now with `focus-serial` bumped.
    in-out property <string> focus-key;
    in-out property <int> focus-serial;
    // The window y of the top and the bottom of the sheet's control that took the focus last,
    // which the sheet's body scrolls into view; `reveal-serial` counts them.
    in-out property <length> reveal-top;
    in-out property <length> reveal-bottom;
    in-out property <int> reveal-serial;

    // A field was edited (a webview `input`, a checkbox's or a select's change).
    callback edited(key: string);
    // A field was changed: Enter, or left once edited.
    callback committed(key: string);
    // A field lost the focus; `changed`: it was just committed for it.
    callback left(key: string, changed: bool);
    // The complexity slider moved to `value`.
    callback slid(value: float);
    // A stepper button was pressed with the pointer, then released (or the pointer left it).
    callback step-pressed(key: string, up: bool);
    callback step-released();
    // A stepper button was activated from the keyboard or a screen reader: one step.
    callback step-key(key: string, up: bool);
    callback browse(key: string);
    callback pick-preset(id: string);
    // "Clear inspection cache…": the host asks to confirm, then clears it.
    callback clear-cache();
    // Bumped when a dialog closes over the sheet, after `Focus.restore`: Done is the fallback.
    in-out property <int> dialog-closed;

    // A field took the focus: the one that had it is left first.
    public function enter(key: string) {
        if self.focused != key {
            self.leave(self.focused);
            self.focused = key;
        }
    }

    // The field `key` lost the focus, or the sheet closes over it: it changes if edited, then is
    // left. Nothing when another field already took the focus (it left this one).
    public function leave(key: string) {
        if key != "" && self.focused == key {
            self.focused = "";
            let changed = self.changed-since;
            if changed {
                self.changed-since = false;
                self.committed(key);
            }
            self.left(key, changed);
        }
    }

    // A control of the sheet that spans `top` (window y) to `top + height` took the focus.
    public function reveal(top: length, height: length) {
        self.reveal-top = top;
        self.reveal-bottom = top + height;
        self.reveal-serial += 1;
    }

    // Enter in the focused field: a change, if edited.
    public function accept(key: string) {
        if self.changed-since && self.focused == key {
            self.changed-since = false;
            self.committed(key);
        }
    }
}

// The gear icon (index.html .task-settings-btn svg): a cog around a circle.
component GearIcon inherits Path {
    width: 17px;
    height: 17px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.9px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z";
}

// A mode tab's gear (.icon-btn.task-settings-btn): opens the mode's settings sheet, which gives the
// focus back to it when it closes.
export component GearButton inherits Pressable {
    in property <string> label;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    accessible-label: root.label;
    tip: root.label;
    GearIcon {
        stroke: root.hovered ? Theme.fg : Theme.mute;
        accessible-role: none;
    }
}

// A Preset Profile row (.nav.preset-row): a dot, the name over the encode it sets. Locked while a
// batch runs (.lock-while-job).
export component PresetRow inherits Pressable {
    in property <PresetItem> item;
    height: 44px;
    border-radius: 8px;
    background: item.active ? Theme.accent-soft : self.hovered && self.enabled ? Theme.hover : transparent;
    border-width: item.active ? 1px : 0px;
    border-color: Theme.accent-ring;
    opacity: self.enabled ? 1 : 0.75;
    accessible-label: item.a11y;
    accessible-checkable: true;
    accessible-checked: item.active;
    focus-key: "preset:" + item.id;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            border-width: 2px;
            border-color: root.item.active ? Theme.accent : Theme.mute;
            background: root.item.active ? Theme.accent : transparent;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.name;
                color: Theme.fg;
                font-weight: root.item.active ? 600 : 500;
                overflow: elide;
                accessible-role: none;
            }
            Text {
                text: root.item.sub;
                color: Theme.mute;
                font-size: 11px;
                overflow: elide;
                accessible-role: none;
            }
        }
    }
}

// A section heading (.sheet-section h3; the Inspector's .insp-section h4 looks the same).
export component SectionHead inherits Text {
    color: Theme.mute;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.77px;
}

// A labelled field (.field-label): the label, and a "required" tag, over its control. `tip` is
// the label's `title`: a hover tooltip over the whole field, its control and buttons included, as
// the webview's `<label>` wraps them. Not a layout itself: a `Tooltip` cannot sit in one.
component Field inherits Rectangle {
    in property <string> label;
    in property <bool> required;
    in property <string> tip;
    // Columns of fields share the width evenly (.grid-2, .grid-3).
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.label;
                color: Theme.mute;
                font-size: 12px;
                font-weight: 500;
                accessible-role: none;
            }
            if root.required: Text {
                text: "REQUIRED";
                color: Theme.warn;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        @children
    }
    // Last, so it is over the field: it watches the pointer and passes every event on.
    if root.tip != "": Tooltip {
        TipCard {
            text: root.tip;
        }
    }
}

// A text field of the draft `key`: each keystroke is an edit, Enter or leaving it once edited a
// change (Sheet). `flagged`: the field the last Run could not read (.input-error).
component DraftEdit inherits TextField {
    in property <string> key;
    in property <string> label;
    in property <string> description;
    in property <bool> flagged;
    // Mirrors Sheet.focus-serial, which a change of fires on.
    property <int> serial: Sheet.focus-serial;
    accessible-label: root.label;
    accessible-description: root.description;
    border-color: root.flagged ? Theme.err : Theme.line;
    init => { self.grab(); }
    changed serial => { self.grab(); }
    // A disabled field is passed over, as Pressable's restore does: its focus() would move the
    // focus on, out of the sheet once every control after it is locked.
    function grab() {
        if root.enabled && Sheet.focus-key == root.key && root.key != "" {
            root.focus();
            // A field made with the focus reports no change of it.
            if root.has-focus {
                Sheet.enter(root.key);
                Sheet.reveal(root.absolute-position.y, root.height);
            }
        }
    }
    edited => {
        Sheet.changed-since = true;
        Sheet.edited(root.key);
    }
    accepted => { Sheet.accept(root.key); }
    changed has-focus => {
        if self.has-focus {
            Sheet.enter(root.key);
            Sheet.reveal(root.absolute-position.y, root.height);
        } else {
            Sheet.leave(root.key);
        }
    }
    // .input-error's 2px halo, around the err border.
    if root.flagged: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: root.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.err-soft;
    }
}

// A folder field with its Browse… button (.input-row).
component FolderField inherits Field {
    in property <string> key;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> enabled;
    in property <bool> flagged;
    HorizontalLayout {
        spacing: 6px;
        DraftEdit {
            key: root.key;
            text <=> root.value;
            placeholder: root.placeholder;
            enabled: root.enabled;
            label: root.label;
            flagged: root.flagged;
            // .field.mono
            font-family: "JetBrains Mono";
        }
        Button {
            text: "Browse…";
            enabled: root.enabled;
            accessible-label: "Browse for the " + root.label;
            changed has-focus => {
                if self.has-focus {
                    Sheet.reveal(self.absolute-position.y, self.height);
                }
            }
            clicked => {
                Sheet.leave(Sheet.focused);
                Sheet.browse(root.key);
            }
        }
    }
}

// A stepper's − or + (.stepper-btn): a press steps once, a hold repeats (the host's timer); Enter,
// Space or a screen reader's action steps once.
component StepButton inherits Pressable {
    in property <string> key;
    in property <bool> up;
    in property <string> label;
    width: 30px;
    border-top-left-radius: root.up ? 0px : 8px;
    border-bottom-left-radius: root.up ? 0px : 8px;
    border-top-right-radius: root.up ? 8px : 0px;
    border-bottom-right-radius: root.up ? 8px : 0px;
    border-width: 1px;
    border-color: Theme.line;
    background: self.pressed ? Theme.sel : self.hovered && root.enabled ? Theme.hover : Theme.field;
    opacity: root.enabled ? 1 : 0.5;
    cursor: default;
    pointer-click: false;
    accessible-label: root.label;
    focus-key: "step:" + root.key + (root.up ? "+" : "-");
    changed focused => {
        if self.focused {
            Sheet.reveal(root.absolute-position.y, root.height);
        }
    }
    clicked => { Sheet.step-key(root.key, root.up); }
    pointer(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            Sheet.step-pressed(root.key, root.up);
        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
            Sheet.step-released();
        }
    }
    changed hovered => {
        if !self.hovered {
            Sheet.step-released();
        }
    }
    Text {
        text: root.up ? "+" : "−";
        color: Theme.fg;
        font-weight: 700;
        accessible-role: none;
    }
}

// A number field between its − and + (.number-stepper).
component StepperField inherits Field {
    in property <string> key;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> enabled;
    in property <bool> flagged;
    // What the buttons step, for their labels: "Decrease workers".
    in property <string> noun;
    // The field's tooltip in index.html, read out by a screen reader.
    in property <string> description;
    in property <InputType> input-type: number;
    tip: root.description;
    HorizontalLayout {
        StepButton {
            key: root.key;
            up: false;
            label: "Decrease " + root.noun;
            enabled: root.enabled;
        }
        DraftEdit {
            key: root.key;
            text <=> root.value;
            placeholder: root.placeholder;
            enabled: root.enabled;
            label: root.label;
            flagged: root.flagged;
            description: root.description;
            input-type: root.input-type;
            horizontal-alignment: center;
        }
        StepButton {
            key: root.key;
            up: true;
            label: "Increase " + root.noun;
            enabled: root.enabled;
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.sep;
}

// One mode's settings sheet (.sheet): the head with Done, then the sections, which scroll. The
// window shows it over a backdrop (app.slint).
export component SettingsSheet inherits GlassPane {
    dimmed: true;
    in property <string> title;
    in property <bool> remux;
    in-out property <DraftForm> form;
    // The bitrate select's entries.
    in property <[string]> bitrates;
    in property <ChipTexts> chips;
    in property <SheetLimits> limits;
    // The draft key the last Run could not read: its field is flagged.
    in property <string> invalid;
    // A start or a job holds the batch: the locked note shows (html.job-locked).
    in property <bool> busy;
    // That, or a Run not answered yet: the fields are locked (.lock-while-job).
    in property <bool> locked;
    // The confirm dialog is over the sheet, with the focus.
    in property <bool> dialog-open;
    // The output folder's placeholder, which differs per mode.
    in property <string> out-placeholder;
    callback done();
    // The height the head and every section take, unscrolled.
    out property <length> natural-height: head.preferred-height + 1px + body.preferred-height;

    // The slider's value, which follows the typed complexity while it reads as a number.
    property <float> complexity: 5;
    changed form => { self.follow(); }
    function follow() {
        if root.form.complexity.is-float() {
            root.complexity = root.form.complexity.to-float();
        }
    }
    // Done takes the focus unless a field took it for `Sheet.focus-key`: on opening, and again
    // when the host moves the cursor (`focus-serial`). Whichever of this and the fields' grab runs
    // first, the field's focus wins.
    init => {
        self.follow();
        self.focus-done();
    }
    property <int> serial: Sheet.focus-serial;
    changed serial => { self.focus-done(); }
    // Locked under a focused control, Done takes the focus, so Tab stays inside the sheet (locked,
    // Done is its only control) and Esc keeps closing it. A dialog over the sheet keeps it: Done
    // takes it as the dialog closes, when the control that had it is locked.
    changed locked => {
        if root.locked && !root.dialog-open {
            done-button.focus();
        }
    }
    function focus-done() {
        if Sheet.focused == "" {
            done-button.focus();
        }
    }

    // The sheet's control that took the focus last scrolls into view (the browser does it for a
    // focused field).
    property <int> reveal: Sheet.reveal-serial;
    changed reveal => { self.scroll-into-view(); }
    function scroll-into-view() {
        let top = Sheet.reveal-top - scroller.absolute-position.y - 8px;
        let bottom = Sheet.reveal-bottom - scroller.absolute-position.y + 8px;
        if top < 0px {
            scroller.content-y = min(0px, scroller.content-y - top);
        } else if bottom > scroller.visible-height {
            scroller.content-y = max(scroller.visible-height - scroller.content-height, scroller.content-y - (bottom - scroller.visible-height));
        }
    }

    width: 580px;
    // .sheet.glass (GlassPane).
    border-radius: 26px;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.title;

    // Takes the clicks the backdrop behind it would close the sheet on.
    TouchArea { }

    // A dialog closed over the sheet gives the focus back to the control that had it; Done takes
    // it when that control is gone or locked (a batch that started meanwhile) or was not one that
    // takes it back. Whichever of this and the control's own handler runs first, the control wins.
    property <int> dialog-closed: Sheet.dialog-closed;
    changed dialog-closed => {
        if Focus.current != Focus.restore-key || Focus.restore-key == "" {
            done-button.focus();
        }
    }

    // Keeps Tab and Shift+Tab inside the sheet, as a modal dialog does: past its last control the
    // focus wraps to Done, and back from Done to the last one. Locked, Done is the only one.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            let back = event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift);
            if back && done-button.focused {
                if root.locked {
                    done-button.focus();
                } else {
                    clear-cache.focus();
                }
                return accept;
            }
            if !back && event.text == Key.Tab && (clear-cache.focused || (root.locked && done-button.focused)) {
                done-button.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // .sheet-head
            head := HorizontalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title;
                        color: Theme.fg;
                        font-size: 16px;
                        font-weight: 700;
                        // The sheet carries it as its label.
                        accessible-role: none;
                    }
                    Text {
                        text: "Applies to every episode in the next batch.";
                        color: Theme.mute;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                // .cap.btn-accent: takes the focus when the sheet opens, so Enter or Space closes it.
                done-button := CapButton {
                    text: "Done";
                    clicked => { root.done(); }
                }
            }
            Divider { }

            // .sheet-body: only the body scrolls.
            scroller := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    padding-top: 4px;
                    padding-bottom: 20px;
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: start;

                    if root.busy: VerticalLayout {
                        padding-top: 14px;
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.warn.transparentize(86%);
                            height: note.preferred-height + 16px;
                            note := Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: "Locked while a batch runs. Changes apply to the next batch.";
                                color: Theme.warn;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if !root.remux: VerticalLayout {
                        padding-top: 14px;
                        Text {
                            text: "Extracts the best subtitle track, deduplicated fonts, chapters and cover art.";
                            color: Theme.mute;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    // Folders
                    VerticalLayout {
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        SectionHead { text: "FOLDERS"; }
                        FolderField {
                            label: "Input folder";
                            required: true;
                            key: "input_dir";
                            value <=> root.form.input-dir;
                            placeholder: "Release folder with the MKV episodes";
                            enabled: !root.locked;
                            flagged: root.invalid == "input_dir";
                        }
                        FolderField {
                            label: "Output directory";
                            key: "out_dir";
                            value <=> root.form.out-dir;
                            placeholder: root.out-placeholder;
                            enabled: !root.locked;
                        }
                        FolderField {
                            label: "Fonts directory";
                            key: "fonts_dir";
                            value <=> root.form.fonts-dir;
                            placeholder: "Auto: fonts folder";
                            enabled: !root.locked;
                        }
                        if root.remux: FolderField {
                            label: "Assets directory";
                            key: "assets_dir";
                            value <=> root.form.assets-dir;
                            placeholder: "Optional fallback for subtitles";
                            enabled: !root.locked;
                        }
                    }

                    // Audio & subtitles (remux)
                    if root.remux: VerticalLayout {
                        Divider { }
                        VerticalLayout {
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            SectionHead { text: "AUDIO & SUBTITLES"; }
                            HorizontalLayout {
                                spacing: 12px;
                                Field {
                                    label: "Opus bitrate";
                                    Select {
                                        model: root.bitrates;
                                        current-index <=> root.form.bitrate;
                                        enabled: !root.locked;
                                        accessible-label: "Opus bitrate";
                                        changed focused => {
                                            if self.focused {
                                                Sheet.reveal(self.absolute-position.y, self.height);
                                            }
                                        }
                                        // The entry shown picked again sends nothing.
                                        picked(index, changed) => {
                                            if changed {
                                                Sheet.edited("bitrate");
                                                Sheet.committed("bitrate");
                                            }
                                        }
                                    }
                                }
                                StepperField {
                                    label: "Subtitle offset (seconds)";
                                    noun: "offset";
                                    key: "sub_offset";
                                    value <=> root.form.sub-offset;
                                    placeholder: "0.0";
                                    // A decimal field would follow the locale's separator, where
                                    // the core reads a point: any text, as typed.
                                    input-type: text;
                                    enabled: !root.locked;
                                    flagged: root.invalid == "sub_offset";
                                }
                            }
                            Field {
                                label: "Encoder complexity";
                                tip: root.limits.complexity-tip;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 6px;
                                        border-width: root.invalid == "complexity" ? 2px : 0px;
                                        border-color: Theme.err;
                                        Slider {
                                            x: 4px;
                                            width: parent.width - 8px;
                                            minimum: root.limits.complexity-min;
                                            maximum: root.limits.complexity-max;
                                            step: 1;
                                            value <=> root.complexity;
                                            enabled: !root.locked;
                                            accessible-label: "Encoder complexity";
                                            accessible-description: root.limits.complexity-tip;
                                            // Whole steps alone, as a range input's: fluent's
                                            // drag does not snap to `step`.
                                            changed(value) => {
                                                let step = Math.round(value);
                                                self.value = step;
                                                Sheet.slid(step);
                                            }
                                            released => { Sheet.committed("complexity"); }
                                            // A focus id of its own, so moving between the
                                            // slider and the box leaves one and enters the other.
                                            changed has-focus => {
                                                if self.has-focus {
                                                    Sheet.enter("complexity_slider");
                                                    Sheet.reveal(self.absolute-position.y, self.height);
                                                } else {
                                                    Sheet.leave("complexity_slider");
                                                }
                                            }
                                        }
                                    }
                                    DraftEdit {
                                        width: 52px;
                                        horizontal-stretch: 0;
                                        key: "complexity";
                                        text <=> root.form.complexity;
                                        enabled: !root.locked;
                                        label: "Encoder complexity value";
                                        description: root.limits.complexity-tip;
                                        flagged: root.invalid == "complexity";
                                        input-type: number;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Performance
                    Divider { }
                    VerticalLayout {
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        SectionHead { text: "PERFORMANCE"; }
                        HorizontalLayout {
                            spacing: 12px;
                            StepperField {
                                label: "Workers";
                                noun: "workers";
                                key: "workers";
                                value <=> root.form.workers;
                                placeholder: root.chips.workers-hint;
                                enabled: !root.locked;
                                flagged: root.invalid == "workers";
                                description: root.limits.workers-tip;
                            }
                            StepperField {
                                label: "Disk I/O";
                                noun: "disk I/O jobs";
                                key: "io_jobs";
                                value <=> root.form.io-jobs;
                                placeholder: root.chips.io-jobs-hint;
                                enabled: !root.locked;
                                flagged: root.invalid == "io_jobs";
                                description: root.limits.io-jobs-tip;
                            }
                            if root.remux: StepperField {
                                label: "FFmpeg threads";
                                noun: "FFmpeg threads";
                                key: "ffmpeg_threads";
                                value <=> root.form.ffmpeg-threads;
                                placeholder: "auto";
                                enabled: !root.locked;
                                flagged: root.invalid == "ffmpeg_threads";
                                description: root.limits.ffmpeg-threads-tip;
                            }
                            // Extract has two of the three columns (.grid-3).
                            if !root.remux: Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    // Run options.
                    Divider { }
                    VerticalLayout {
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        SectionHead { text: "RUN OPTIONS"; }
                        CheckBox {
                            text: "Dry run (plan only, write nothing)";
                            checked <=> root.form.dry-run;
                            enabled: !root.locked;
                            toggled => { Sheet.edited("dry_run"); }
                            changed has-focus => {
                                if self.has-focus {
                                    Sheet.reveal(self.absolute-position.y, self.height);
                                }
                            }
                        }
                        CheckBox {
                            text: "Bypass inspection cache";
                            checked <=> root.form.no-cache;
                            enabled: !root.locked;
                            toggled => { Sheet.edited("no_cache"); }
                            changed has-focus => {
                                if self.has-focus {
                                    Sheet.reveal(self.absolute-position.y, self.height);
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            clear-cache := PillButton {
                                text: "Clear inspection cache…";
                                enabled: !root.locked;
                                clicked => { Sheet.clear-cache(); }
                                changed focused => {
                                    if self.focused {
                                        Sheet.reveal(self.absolute-position.y, self.height);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

#!/usr/bin/env bash
# Refuses a commit message that credits an AI agent as a co-author.
#
# Why a hook rather than a Claude Code setting: `attribution.commit: ""` in settings.json is
# the documented lever, but it has open upstream reports of having no effect, so the trailer
# can still land (anthropics/claude-code#45137, #65657). This hook is the enforceable half:
# git records no commit whose trailer block names an AI agent.
#
# Scope is the trailer block only. A line of prose that mentions one, or a context line in a
# `git commit -v` diff, is not a trailer and must not block the commit -- the next commit
# documenting this hook would otherwise be uncommittable.
#
# A co-author naming a human -- including `Co-authored-by: sifahaz <...@users.noreply.github.com>` --
# is left alone. Enabled per clone by scripts/install-git-hooks.sh.
set -euo pipefail

# git passes the path to the message file. Refuse rather than trust it: a hook that cannot
# read what it must inspect would approve every message.
msg=${1:?"[commit-msg] needs the path to the commit message file"}
[ -r "$msg" ] || { echo "❌ [commit-msg] cannot read the commit message at $msg." >&2; exit 1; }

# A trailer is a line of its own; git accepts whitespace before the colon, so allow it.
trailer='^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y[[:space:]]*:'

# Identify each agent by the address it always signs with rather than by the name beside it,
# so a human called Jean-Claude, or one at dev@copilot-firm.com, is not caught by a substring.
# `AI Bot` carries no identifying address, so its exact two-word name is matched instead.
address='noreply@anthropic\.com|\+copilot@users\.noreply\.github\.com'
by_name='^[Cc]o-[Aa]uthored-[Bb]y[[:space:]]*:[[:space:]]*ai[[:space:]]+bot[[:space:]]*(<|$)'

# --no-divider: without it git reads a `---` line as the end of the message, as it would in a
# format-patch email, so a Markdown or YAML divider would hide every trailer below it.
# An indented line stays accepted, and that matches git: it reads as paragraph continuation.
# A message that is one bare trailer line has no trailer block, so git treats it as the
# subject; GitHub reads it the same way, so there is no attribution to remove there.
parsed=$(git interpret-trailers --no-divider --parse <"$msg" || true)
trailers=$(
  {
    printf '%s\n' "$parsed" | grep -iE "$trailer.*($address)" || true
    grep -iE "$by_name" "$msg" || true
  } | sed '/^[[:space:]]*$/d'
)

if [ -n "$trailers" ]; then
  {
    echo ""
    echo "❌ [commit-msg] refusing to commit an AI co-author trailer:"
    printf '%s\n' "$trailers" | sed 's/^/     /'
    echo ""
    echo "   Drop the line above. To credit a person, name them instead: an AI"
    echo "   co-author is never kept. Attribution is a choice, not a default."
    echo "   Bypass: git commit --no-verify"
    echo ""
  } >&2
  exit 1
fi

exit 0
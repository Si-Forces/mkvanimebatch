#!/usr/bin/env bash
# Fast gates on every commit; the slow test suites run in pre-push.
# Enabled per clone by scripts/install-git-hooks.sh.
set -euo pipefail

# -z keeps non-ASCII paths unquoted. Deletions are included: removing a .rs file can
# break the build as surely as editing one.
mapfile -d '' staged < <(git diff --cached --name-only -z)
wait $! # a process substitution's failure is otherwise ignored

rust=0
ui_js=()
for f in "${staged[@]}"; do
  case "$f" in
    *.rs | Cargo.toml | */Cargo.toml | Cargo.lock) rust=1 ;;
    desktop-tauri/ui/*.js) ui_js+=("$f") ;;
  esac
done

fail=0

if [ "$rust" -eq 1 ]; then
  # cargo reads the working tree, so it must hold exactly what is being committed.
  unstaged=$(git diff --name-only -- '*.rs' '*Cargo.toml' Cargo.lock)
  untracked=$(git ls-files --others --exclude-standard -- '*.rs' '*Cargo.toml')
  # git diff skips assume-unchanged and skip-worktree entries, so it cannot vouch for them.
  hidden=$(git ls-files -v -- '*.rs' '*Cargo.toml' Cargo.lock | sed -n 's/^[a-zS] //p')
  if [ -n "$unstaged$untracked$hidden" ]; then
    echo "❌ [pre-commit] these Rust/Cargo files may differ from the index, so cargo would not check the commit:" >&2
    printf '%s\n%s\n' "$unstaged" "$untracked" | sed '/^$/d; s/^/   /' >&2
    if [ -n "$hidden" ]; then
      printf '%s\n' "$hidden" | sed 's/^/   (assume-unchanged or skip-worktree) /' >&2
      echo "   Clear the bits with: git update-index --no-assume-unchanged --no-skip-worktree <path>" >&2
    fi
    echo "   Stage them, or set them aside with: git stash push --keep-index --include-untracked" >&2
    exit 1
  fi
  echo "[pre-commit] cargo fmt --check (workspace)..."
  cargo fmt --all -- --check || { echo "❌ [pre-commit] cargo fmt failed. Run: cargo fmt --all" >&2; fail=1; }
  echo "[pre-commit] cargo clippy -D warnings (workspace, all targets)..."
  cargo clippy --workspace --all-targets -- -D warnings || { echo "❌ [pre-commit] clippy failed." >&2; fail=1; }
fi

# Checks the staged blob itself, so unstaged edits cannot hide a syntax error.
for f in "${ui_js[@]}"; do
  git cat-file -e ":$f" 2> /dev/null || continue # staged deletion
  # theme-init.js must stay a classic script (CSP, see its header); the rest are modules.
  case "$f" in */theme-init.js) input_type=commonjs ;; *) input_type=module ;; esac
  git show ":$f" | node --check --input-type="$input_type" ||
    { echo "❌ [pre-commit] node --check failed: $f" >&2; fail=1; }
done

exit "$fail"

#!/usr/bin/env bash
# Fast CI gates on every commit. Canonical copy lives at scripts/hooks/pre-commit;
# install with: scripts/install-git-hooks.sh
#
# Covers the whole Rust workspace, not just src-tauri. The hook this replaced only
# ran `cargo fmt` when desktop-tauri files were staged, so a formatting error in
# crates/mkv-core reached a commit unblocked.
#
# The slow gates (cargo test, node --test) run in pre-push instead, so nothing
# reaches origin/main without them.
set -euo pipefail

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then exit 0; fi

fail=0

if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
  echo "[pre-commit] cargo fmt --check (workspace)..."
  if ! cargo fmt --all -- --check; then
    echo ""; echo "❌ [pre-commit] cargo fmt failed. Run: cargo fmt --all"; echo ""
    fail=1
  fi
  echo "[pre-commit] cargo clippy -D warnings (workspace, all targets)..."
  if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo ""; echo "❌ [pre-commit] clippy failed."; echo ""
    fail=1
  fi
fi

if printf '%s\n' "$staged" | grep -qE 'desktop-tauri/ui/.*\.js$'; then
  echo "[pre-commit] node --check on staged UI modules..."
  while read -r f; do
    [ -f "$f" ] || continue
    if ! node --check "$f"; then
      echo ""; echo "❌ [pre-commit] node --check failed: $f"; echo ""
      fail=1
    fi
  done <<< "$staged"
fi

exit $fail
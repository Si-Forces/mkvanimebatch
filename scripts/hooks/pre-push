#!/usr/bin/env bash
# Push-time gates: the review-gate ledger for each pushed ref, then the slow test suites.
# Enabled per clone by scripts/install-git-hooks.sh.
set -euo pipefail

# git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per ref.
# Deleting a ref pushes an all-zero local sha: nothing to test or review.
updates=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue
  updates+=("$remote_sha $local_sha")
done
[ "${#updates[@]}" -gt 0 ] || exit 0

root=$(git rev-parse --show-toplevel)

# The ledger check is cheap, so it runs before the test suites.
if [ "${SKIP_REVIEW_GATE:-0}" = "1" ]; then
  echo "[review-gate] SKIP_REVIEW_GATE=1 — pushing unreviewed."
else
  gate="$root/scripts/review-gate.sh"
  if [ ! -x "$gate" ]; then
    echo "❌ [review-gate] scripts/review-gate.sh is missing or not executable." >&2
    echo "   Run: chmod +x scripts/review-gate.sh  (or git checkout -- scripts/review-gate.sh if it was deleted)" >&2
    exit 1
  fi
  for update in "${updates[@]}"; do
    read -r remote_sha local_sha <<< "$update"
    "$gate" verify-push "$remote_sha" "$local_sha"
  done
fi

if [ "${SKIP_SLOW_GATES:-0}" = "1" ]; then
  echo "[pre-push] SKIP_SLOW_GATES=1 — skipping test suites."
  exit 0
fi

# The suites run on the working tree, so they can only vouch for HEAD. Other pushed tips
# (a second branch, an older tag) go through untested here rather than being refused.
head=$(git rev-parse HEAD)
pushes_head=0
for update in "${updates[@]}"; do
  read -r _ local_sha <<< "$update"
  commit=$(git rev-parse "$local_sha^{commit}")
  if [ "$commit" = "$head" ]; then
    pushes_head=1
  else
    echo "⚠  [pre-push] $(git rev-parse --short "$commit") is not HEAD; the local test suites do not cover it." >&2
  fi
done
[ "$pushes_head" -eq 1 ] || exit 0

# The suites read the working tree, so it must hold exactly HEAD. Untracked files count
# only where the suites would pick them up (an untracked module can satisfy a tracked mod).
helper="$(dirname "$0")/hidden-changes.sh"
source "$helper" || { echo "❌ [pre-push] cannot load $helper. Restore it: git checkout -- scripts/hooks/hidden-changes.sh" >&2; exit 1; }
hidden=$(hidden_changes) || { echo "❌ [pre-push] cannot list the index to check for hidden edits." >&2; exit 1; }
dirty=$(git diff --name-only HEAD)
untracked=$(git ls-files --others --exclude-standard -- '*.rs' '*Cargo.toml' 'desktop-tauri/ui/*' 'scripts/*')
if [ -n "$dirty$untracked$hidden" ]; then
  echo "❌ [pre-push] the working tree differs from HEAD, so the tests would not run on the pushed commit." >&2
  if [ -n "$dirty$untracked" ]; then
    printf '%s\n%s\n' "$dirty" "$untracked" | sed '/^$/d; s/^/     /' >&2
    echo "   Commit, stash or remove them." >&2
  fi
  [ -z "$hidden" ] || explain_hidden_changes "$hidden"
  echo "   To push without the test suites: SKIP_SLOW_GATES=1 git push" >&2
  exit 1
fi

echo "[pre-push] cargo test --workspace..."
cargo test --workspace || { echo "❌ [pre-push] cargo test failed." >&2; exit 1; }
echo "[pre-push] node --test scripts/*.test.js desktop-tauri/ui/*.test.js..."
node --test "$root"/scripts/*.test.js "$root"/desktop-tauri/ui/*.test.js || { echo "❌ [pre-push] node --test failed." >&2; exit 1; }

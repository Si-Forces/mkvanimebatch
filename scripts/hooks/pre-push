#!/usr/bin/env bash
# Push-time gates: the review-gate ledger for each pushed ref, then the slow test suites.
# Enabled per clone by scripts/install-git-hooks.sh.
set -euo pipefail

# git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per ref.
# Deleting a ref pushes an all-zero local sha: nothing to test or review.
updates=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue
  updates+=("$remote_sha $local_sha")
done
[ "${#updates[@]}" -gt 0 ] || exit 0

root=$(git rev-parse --show-toplevel)

# The ledger check is cheap, so it runs before the test suites.
if [ "${SKIP_REVIEW_GATE:-0}" = "1" ]; then
  echo "[review-gate] SKIP_REVIEW_GATE=1 — pushing unreviewed."
else
  for update in "${updates[@]}"; do
    read -r remote_sha local_sha <<< "$update"
    "$root/scripts/review-gate.sh" verify-push "$remote_sha" "$local_sha"
  done
fi

if [ "${SKIP_SLOW_GATES:-0}" = "1" ]; then
  echo "[pre-push] SKIP_SLOW_GATES=1 — skipping test suites."
  exit 0
fi

# The suites run on the working tree, so it must be the commit being pushed.
head=$(git rev-parse HEAD)
for update in "${updates[@]}"; do
  read -r _ local_sha <<< "$update"
  commit=$(git rev-parse "$local_sha^{commit}")
  if [ "$commit" != "$head" ]; then
    echo "❌ [pre-push] the tests run on the checkout, but $(git rev-parse --short "$commit") is not HEAD." >&2
    echo "   Check it out and push again, or skip the suites with SKIP_SLOW_GATES=1." >&2
    exit 1
  fi
done
if ! git diff --quiet HEAD; then
  echo "❌ [pre-push] tracked files differ from HEAD, so the tests would not run on the pushed commit." >&2
  echo "   Commit or stash them first." >&2
  exit 1
fi

echo "[pre-push] cargo test --workspace..."
cargo test --workspace || { echo "❌ [pre-push] cargo test failed." >&2; exit 1; }
echo "[pre-push] node --test desktop-tauri/ui/*.test.js..."
node --test "$root"/desktop-tauri/ui/*.test.js || { echo "❌ [pre-push] node --test failed." >&2; exit 1; }
